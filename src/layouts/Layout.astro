---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileBar from "../components/MobileBar.astro";
import Attribution from "../components/Attribution.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  contactHref?: string;
  noindex?: boolean;
}
const { title, description, contactHref = "/contact", noindex = false } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, site.url).toString();
const serviceArea = site.serviceArea
  .flatMap((entry) => entry.name.split("/").map((city) => city.trim()))
  .map((city) => ({ "@type": "City", name: `${city}, MI` }));

// Crossbell is a service-area business without a public storefront. Keep one
// stable Organization entity on the home page instead of presenting an
// incomplete LocalBusiness entity with a different description on every URL.
const homePageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site.url}/#organization`,
      name: site.name,
      legalName: site.legalName,
      url: `${site.url}/`,
      logo: new URL("/brand/crossbell-crest.png", site.url).toString(),
      image: new URL("/og.png", site.url).toString(),
      telephone: site.phoneTel,
      email: site.email,
      description: site.description,
      areaServed: serviceArea,
    },
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      url: `${site.url}/`,
      name: site.name,
      publisher: { "@id": `${site.url}/#organization` },
      inLanguage: "en-US",
    },
    {
      "@type": "Service",
      "@id": `${site.url}/#smart-cooler-vending-service`,
      name: "Smart cooler vending service",
      serviceType: "Smart cooler vending machine installation, stocking, and service",
      description: site.description,
      provider: { "@id": `${site.url}/#organization` },
      areaServed: serviceArea,
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
        description: "No-cost machine, delivery, stocking, maintenance, or service for the host location.",
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL("/og.png", site.url).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Crossbell Vending crest — smart vending for Macomb and Oakland County workplaces" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL("/og.png", site.url).toString()} />

    {Astro.url.pathname === "/" && (
      <script type="application/ld+json" set:html={JSON.stringify(homePageSchema)} />
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header contactHref={contactHref} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileBar contactHref={contactHref} />
    <Attribution />
  </body>
</html>

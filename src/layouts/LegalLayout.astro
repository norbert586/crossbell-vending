---
// Shared frame for /privacy, /terms, /accessibility. Content goes in the slot
// as plain h2/p/ul; the .legal class in global.css handles the typography.
import Layout from "./Layout.astro";

interface Props {
  title: string;
  description: string;
  heading: string;
  updated: string; // ISO date, e.g. "2026-09-12"
}
const { title, description, heading, updated } = Astro.props;
const updatedLabel = new Date(`${updated}T12:00:00`).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout title={title} description={description}>
  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-[1120px] px-5 sm:px-8">
      <p class="font-mono text-xs font-semibold tracking-[0.18em] text-accent-dim uppercase">
        Last updated <time datetime={updated}>{updatedLabel}</time>
      </p>
      <h1 class="mt-3 text-[clamp(2.1rem,4vw,3rem)] font-bold">{heading}</h1>
      <div class="legal mt-2">
        <slot />
      </div>
    </div>
  </section>
</Layout>

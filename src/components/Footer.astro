---
import { Image } from "astro:assets";
import { site } from "../data/site";
import crest from "../assets/brand/crest.png";
const year = new Date().getFullYear();
---

<footer class="bg-indigo text-lavender">
  <div class="mx-auto grid max-w-[1120px] gap-8 px-5 py-12 sm:px-8 sm:py-14 md:grid-cols-[1.2fr_1fr_1fr]">
    <div>
      <Image
        src={crest}
        alt="Crossbell Vending crest"
        width={280}
        height={326}
        densities={[1, 2]}
        class="mb-4 h-[140px] w-auto"
        loading="lazy"
      />
      <h2 class="mb-3 font-body text-base font-semibold text-white">Crossbell Vending</h2>
      <p class="max-w-[32ch] text-sm text-lavender">
        AI-powered smart coolers for break rooms, gyms, auto shops, offices, and light industrial
        sites in Macomb and north Oakland County.
      </p>
      <p class="mt-3 text-xs text-[#9EA2D6]">
        {site.legalName} &middot; Macomb County, Michigan &middot; Fully insured
      </p>
    </div>
    <div>
      <h2 class="mb-3 font-body text-base font-semibold text-white">Contact</h2>
      <p class="mb-2">
        <a href={`tel:${site.phoneTel}`} class="hover:text-accent">{site.phone}</a>
      </p>
      <p>
        <a href={`mailto:${site.email}`} class="hover:text-accent break-all">{site.email}</a>
      </p>
      <p class="mt-3">
        <a href="/contact" class="hover:text-accent underline underline-offset-2">Contact page</a>
      </p>
      <p class="mt-1">
        <a href="/machines/" class="hover:text-accent underline underline-offset-2">Our machines</a>
      </p>
    </div>
    <div>
      <h2 class="mb-3 font-body text-base font-semibold text-white">Service area</h2>
      <ul class="columns-2 gap-4 text-sm leading-relaxed">
        {site.serviceArea.map((city) => <li>{city.name}</li>)}
      </ul>
      <p class="mt-2 text-xs text-[#9EA2D6]">{site.serviceAreaNote}</p>
    </div>
  </div>
  <div class="mx-auto flex max-w-[1120px] flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-indigo-2 px-5 py-5 text-xs text-[#9EA2D6] sm:px-8">
    <span>&copy; {year} {site.legalName}. All rights reserved.</span>
    <nav aria-label="Legal">
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        <li><a href="/privacy/" class="underline underline-offset-2 hover:text-accent">Privacy policy</a></li>
        <li><a href="/terms/" class="underline underline-offset-2 hover:text-accent">Terms of use</a></li>
        <li><a href="/accessibility/" class="underline underline-offset-2 hover:text-accent">Accessibility</a></li>
      </ul>
    </nav>
  </div>
</footer>

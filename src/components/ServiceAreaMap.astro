---
// The service area, drawn from the coordinates in src/data/site.ts.
//
// Two maps: the local route, and a Michigan silhouette so a visitor from out of
// state knows where that is. Town positions are a plain equirectangular
// projection of real latitude/longitude, so they sit where they actually sit
// relative to one another. The shaded territory is approximate.
import { site } from "../data/site";

const W = 520;
const H = 520;
const LON_MIN = -83.2163;
const LAT_MAX = 42.87;
const K_Y = 1575.8; // px per degree of latitude
const K_X = K_Y * Math.cos((42.7 * Math.PI) / 180); // squash longitude to match

// Macomb/Oakland county line runs up Dequindre Road.
const COUNTY_LINE_LON = -83.07;
const countyX = (COUNTY_LINE_LON - LON_MIN) * K_X;

// Every label sits to the right of its dot; at these coordinates none of them
// collide or reach Lake St. Clair. Add a name here if a new town changes that.
const LABEL_LEFT = new Set<string>();

const cities = site.serviceArea.map((c) => ({
  name: c.name.replace(" Township", " Twp"),
  x: (c.lon - LON_MIN) * K_X,
  y: (LAT_MAX - c.lat) * K_Y,
  home: c.name === site.homeBase,
  left: LABEL_LEFT.has(c.name),
}));

// Michigan's Lower Peninsula, traced coarsely from the real coastline: the
// mitten, Saginaw Bay, the thumb, and the southern border.
const MITTEN =
  "M 47 5 L 67 15 L 75 24 L 78 41 L 74 46 L 65 64 L 75 60 L 85 52 L 97 81 L 84 99 L 75 115 L 4 113 L 15 86 L 12 74 L 10 55 L 15 36 L 25 25 L 36 17 L 42 16 Z";
---

<div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-start">
  <figure class="min-w-0">
    <div class="overflow-x-auto border border-line bg-white">
      <svg
        viewBox={`0 0 ${W} ${H}`}
        class="block h-auto w-full min-w-[440px]"
        role="img"
        aria-label={`Map of the weekly route through ${site.serviceArea.map((c) => c.name).join(", ")}, spanning Macomb County and the north-east corner of Oakland County, Michigan.`}
      >
        <rect x="0" y="0" width={W} height={H} fill="#fbfbff" />

        <!-- Lake St. Clair, along the south-east edge -->
        <path d="M 455 520 C 450 478 458 428 472 396 L 520 388 L 520 520 Z" fill="#cdd1ff" />
        <text x="512" y="508" text-anchor="end" font-family="IBM Plex Sans, sans-serif" font-size="11" fill="#4f5168">
          Lake St. Clair
        </text>

        <!-- The territory we run weekly -->
        <path
          d="M 236 52 C 292 66 312 148 338 232 C 372 292 382 392 368 452 C 352 496 292 508 238 500 C 192 493 170 458 152 412 C 116 384 46 366 52 318 C 58 254 124 234 166 186 C 190 130 204 62 236 52 Z"
          fill="#c49350"
          fill-opacity="0.12"
          stroke="#c49350"
          stroke-width="2"
          stroke-dasharray="8 6"
        />

        <!-- County line -->
        <line x1={countyX} y1="0" x2={countyX} y2={H} stroke="#4f5168" stroke-width="1.2" stroke-dasharray="4 6" opacity="0.55" />
        <text x={countyX - 7} y="20" text-anchor="end" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" fill="#4f5168" letter-spacing="0.8">
          OAKLAND CO.
        </text>
        <text x={countyX + 7} y="20" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" fill="#4f5168" letter-spacing="0.8">
          MACOMB CO.
        </text>

        <!-- The two roads the route actually runs on -->
        <path d="M 242 60 C 236 180 218 260 212 330 L 215 500" fill="none" stroke="#b9bce6" stroke-width="2.5" />
        <text x="249" y="148" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" fill="#8f94d8">M-53</text>
        <path d="M 0 398 L 520 378" fill="none" stroke="#b9bce6" stroke-width="2.5" />
        <text x="20" y="392" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" fill="#8f94d8">M-59</text>

        {cities.map((c) => (
          <Fragment>
            {c.home && <circle cx={c.x} cy={c.y} r="13" fill="#c49350" fill-opacity="0.32" />}
            <circle cx={c.x} cy={c.y} r={c.home ? 6 : 4.5} fill={c.home ? "#c49350" : "#2a2a5c"} stroke="#ffffff" stroke-width="1.6" />
            <text
              x={c.left ? c.x - 9 : c.x + 9}
              y={c.y + 4}
              text-anchor={c.left ? "end" : "start"}
              font-family="IBM Plex Sans, sans-serif"
              font-size="12.5"
              font-weight={c.home ? 700 : 600}
              fill="#141420"
            >
              {c.name}
            </text>
          </Fragment>
        ))}

        <!-- North arrow -->
        <g transform="translate(28, 40)" fill="#4f5168">
          <path d="M 0 -14 L 5.5 6 L 0 1.5 L -5.5 6 Z" />
          <text x="0" y="21" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="700">N</text>
        </g>
      </svg>
    </div>
    <figcaption class="mt-3 text-sm text-muted">
      Towns sit at their real coordinates; the shaded territory is approximate. The gold pin is{" "}
      {site.homeBase} — where the van starts.
    </figcaption>
  </figure>

  <div class="flex flex-col gap-5">
    <div class="flex items-center gap-5 border border-line bg-white p-5">
      <svg viewBox="0 0 100 120" class="block h-auto w-[92px] flex-none" role="img" aria-label="Michigan's Lower Peninsula with the service area marked in its south-east corner.">
        <path d={MITTEN} fill="#e6e8ff" stroke="#2a2a5c" stroke-width="2" stroke-linejoin="round" />
        <circle cx="83" cy="92" r="10" fill="#c49350" fill-opacity="0.32" />
        <circle cx="83" cy="92" r="4" fill="#c49350" stroke="#141420" stroke-width="1.2" />
      </svg>
      <div>
        <p class="font-mono text-xs font-semibold tracking-[0.14em] text-accent-dim uppercase">Right here</p>
        <p class="mt-1 text-sm text-muted">
          South-east Michigan. The whole route fits inside a 25-minute drive.
        </p>
      </div>
    </div>
    <slot />
  </div>
</div>

---
// A route board rather than a conventional locator map. The county geometry
// and town positions use real longitude/latitude, but the names live in a
// linked index so the map remains legible on a phone.
import { site } from "../data/site";

type Pt = readonly [number, number]; // [lon, lat]

interface Projection {
  lonMin: number;
  latMax: number;
  midLat: number;
  scale: number;
  x0: number;
  y0: number;
}

function projectWith(p: Projection) {
  const cos = Math.cos((p.midLat * Math.PI) / 180);
  return ([lon, lat]: Pt): [number, number] => [
    Math.round((p.x0 + (lon - p.lonMin) * cos * p.scale) * 10) / 10,
    Math.round((p.y0 + (p.latMax - lat) * p.scale) * 10) / 10,
  ];
}

function path(points: readonly Pt[], project: (pt: Pt) => [number, number]): string {
  return points.map((pt, i) => `${i === 0 ? "M" : "L"}${project(pt).join(" ")}`).join("") + "Z";
}

function townId(name: string): string {
  return name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
}

const map = projectWith({ lonMin: -83.7, latMax: 42.888, midLat: 42.66, scale: 610, x0: 28, y0: 30 });

const oakland: readonly Pt[] = [
  [-83.7, 42.888], [-83.103, 42.888], [-83.103, 42.4355], [-83.7, 42.4355],
];

const shoreline: readonly Pt[] = [
  [-82.75, 42.735], [-82.72, 42.69], [-82.79, 42.645], [-82.8, 42.585],
  [-82.845, 42.552], [-82.872, 42.505], [-82.886, 42.4355],
];
const macomb: readonly Pt[] = [
  [-83.103, 42.888], [-82.75, 42.888], ...shoreline, [-83.103, 42.4355],
];
const lake: readonly Pt[] = [
  ...shoreline.slice(1),
  [-82.6, 42.4355], [-82.55, 42.52], [-82.56, 42.61], [-82.61, 42.665], [-82.68, 42.7],
];

const towns = site.serviceArea.map((town, index) => {
  const [x, y] = map([town.lon, town.lat]);
  return { ...town, x, y, index: index + 1, id: townId(town.name) };
});

const caption = `Macomb and north Oakland County service map with numbered locations for ${site.serviceArea.map((t) => t.name).join(", ")}.`;
---

<div data-route-board class="route-board overflow-hidden border border-indigo-2 bg-indigo text-white">
  <div class="grid lg:grid-cols-[minmax(0,1.35fr)_minmax(360px,0.65fr)]">
    <figure class="relative border-b border-indigo-2 bg-paper lg:border-r lg:border-b-0">
      <div class="absolute top-4 left-4 z-10 border border-indigo/25 bg-white/90 px-3 py-2 backdrop-blur-sm">
        <span class="block font-mono text-[0.62rem] font-semibold tracking-[0.15em] text-accent-dim uppercase">Michigan</span>
        <span class="mt-0.5 block font-display text-lg font-semibold leading-none text-indigo">Our weekly route</span>
      </div>

      <svg viewBox="0 0 560 340" role="img" aria-label={caption} class="block h-auto w-full">
        <rect width="560" height="340" fill="#f6f7ff"></rect>
        <path d={path(lake, map)} fill="#cbd5ee"></path>

        <g class="county-shapes" stroke="#2a2a5c" stroke-width="2.2" stroke-linejoin="round">
          <path data-county-outline d={path(oakland, map)} fill="#ffffff"></path>
          <path data-county-outline d={path(macomb, map)} fill="#e6e8ff"></path>
        </g>

        <g class="font-mono" font-weight="700" letter-spacing="1.5" fill="#2a2a5c" fill-opacity="0.56" text-anchor="middle">
          <text x="158" y="82" font-size="12">NORTH OAKLAND</text>
          <text x="398" y="64" font-size="12">MACOMB</text>
        </g>
        <text
          x="535"
          y="282"
          text-anchor="end"
          font-size="11"
          font-style="italic"
          fill="#4f5168"
          stroke="#cbd5ee"
          stroke-width="4"
          stroke-linejoin="round"
          paint-order="stroke fill">Lake St. Clair</text>

        <g aria-hidden="true">
          {towns.map((town) => (
            <g
              data-town-id={town.id}
              class="route-location"
              transform={`translate(${town.x} ${town.y})`}
            >
              <g class="route-pin">
                <circle r="13" fill="#c49350" stroke="#141420" stroke-width="1.8"></circle>
                <text
                  y="0.5"
                  text-anchor="middle"
                  dominant-baseline="middle"
                  class="font-mono"
                  font-size="11"
                  font-weight="700"
                  fill="#141420">{town.index}</text>
              </g>
            </g>
          ))}
        </g>
      </svg>

      <figcaption class="sr-only">{caption}</figcaption>
    </figure>

    <div class="flex flex-col p-5 sm:p-6 lg:p-7">
      <div>
        <h3 class="text-2xl font-semibold text-white">Towns on the route</h3>
        <p class="mt-2 text-sm leading-relaxed text-lavender">
          Select a town to ask about a placement there. Nearby community? Send the address and
          we’ll check it against the route.
        </p>
      </div>

      <ol class="mt-5 grid grid-cols-2 gap-x-4 border-t border-indigo-2">
        {towns.map((town) => (
          <li class="border-b border-indigo-2">
            <a
              href="#contact"
              data-town-trigger={town.id}
              aria-label={`Request vending service in ${town.name}`}
              class="route-town-link group flex min-h-11 items-center gap-3 py-2.5 text-sm font-semibold text-white"
            >
              <span class="flex h-6 w-6 flex-none items-center justify-center border border-accent/60 font-mono text-[0.68rem] text-accent transition-colors group-hover:bg-accent group-hover:text-ink">
                {town.index}
              </span>
              <span>{town.name}</span>
            </a>
          </li>
        ))}
      </ol>

      <a
        href="#contact"
        class="mt-6 inline-flex min-h-11 items-center justify-center bg-accent px-5 py-3 text-sm font-semibold text-ink transition-colors hover:bg-accent-hover"
      >
        Request service nearby
      </a>
    </div>
  </div>
</div>

<script>
  import { animate, inView, stagger } from "motion";

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-route-board]").forEach((board) => {
    const clearActiveTown = () => {
      board.querySelectorAll(".is-active").forEach((element) => element.classList.remove("is-active"));
    };

    board.querySelectorAll<HTMLElement>("[data-town-trigger]").forEach((trigger) => {
      const activate = () => {
        clearActiveTown();
        trigger.classList.add("is-active");
        const town = trigger.dataset.townTrigger;
        board.querySelector<HTMLElement>(`[data-town-id="${town}"]`)?.classList.add("is-active");
      };

      trigger.addEventListener("pointerenter", activate);
      trigger.addEventListener("focus", activate);
      trigger.addEventListener("pointerleave", clearActiveTown);
      trigger.addEventListener("blur", clearActiveTown);
    });

    if (reducedMotion) return;

    inView(
      board,
      () => {
        const outlines = board.querySelectorAll<SVGPathElement>("[data-county-outline]");
        outlines.forEach((outline, index) => {
          const length = outline.getTotalLength();
          outline.style.strokeDasharray = `${length}`;
          outline.style.strokeDashoffset = `${length}`;
          animate(
            outline,
            { strokeDashoffset: [length, 0] },
            { duration: 0.72, delay: index * 0.11, ease: [0.16, 1, 0.3, 1] },
          );
        });

        animate(
          board.querySelectorAll(".route-pin"),
          { opacity: [0.25, 1], scale: [0.55, 1] },
          { duration: 0.42, delay: stagger(0.055, { startDelay: 0.22 }), ease: [0.16, 1, 0.3, 1] },
        );
      },
      { amount: 0.25 },
    );
  });
</script>

<style>
  .route-location {
    transition: filter 180ms ease;
  }

  .route-pin {
    transform-box: fill-box;
    transform-origin: center;
  }

  .route-location.is-active {
    filter: drop-shadow(0 0 7px rgb(196 147 80 / 0.75));
  }

  .route-location.is-active circle {
    fill: #f3c475;
    stroke-width: 2.8;
  }

  .route-town-link.is-active {
    color: #cdd1ff;
  }

  @media (prefers-reduced-motion: reduce) {
    .route-location,
    .route-location circle {
      transition: none;
    }
  }
</style>

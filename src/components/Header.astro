---
import { site } from "../data/site";

interface Props {
  contactHref?: string;
}
const { contactHref = "/contact" } = Astro.props;
---

<header class="sticky top-0 z-40 border-b border-line bg-paper">
  <div class="mx-auto flex max-w-[1120px] items-center justify-between gap-4 px-5 py-3 sm:px-8">
    <a href="/" class="font-display text-2xl font-bold tracking-tight text-ink">
      Crossbell<span class="text-accent">.</span>Vending
    </a>
    <div class="flex items-center gap-4 sm:gap-6">
      <a
        href={`tel:${site.phoneTel}`}
        class="flex items-center gap-2 font-mono text-sm font-semibold whitespace-nowrap text-ink"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4 flex-none" aria-hidden="true">
          <path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z"></path>
        </svg>
        <span class="sr-only">Call us at </span>{site.phone}
      </a>
      <a
        href={contactHref}
        class="hidden rounded-[3px] border-2 border-transparent bg-accent px-5 py-2.5 text-sm font-semibold text-ink transition-colors hover:bg-accent-dim sm:inline-flex"
      >
        Contact us
      </a>
    </div>
  </div>
</header>

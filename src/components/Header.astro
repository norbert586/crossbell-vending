---
import { Image } from "astro:assets";
import { site } from "../data/site";
import crest from "../assets/brand/crest.png";

interface Props {
  contactHref?: string;
}
const { contactHref = "/contact" } = Astro.props;

// Absolute "/#id" hrefs so the links work from the contact and thanks pages too.
const nav = [
  { href: "/#how", label: "How it works" },
  { href: "/machines/", label: "Machines" },
  { href: "/#why", label: "Why us" },
  { href: "/#area", label: "Service area" },
  { href: "/#faq", label: "FAQ" },
];
---

<header class="sticky top-0 z-40 border-b-2 border-lavender bg-white">
  <div class="mx-auto flex max-w-[1120px] items-center justify-between gap-4 px-5 py-2.5 sm:px-8">
    <a href="/" class="flex items-center gap-2.5 font-display text-2xl font-bold tracking-tight text-ink">
      <Image
        src={crest}
        alt=""
        width={96}
        height={112}
        densities={[1, 2]}
        class="h-12 w-auto flex-none"
        loading="eager"
      />
      <span class="hidden min-[360px]:inline">Crossbell Vending</span>
      <span class="min-[360px]:hidden">Crossbell</span>
    </a>
    <nav aria-label="Sections" class="hidden lg:block">
      <ul class="flex items-center gap-6">
        {nav.map((item) => (
          <li>
            <a href={item.href} class="text-sm font-medium text-ink transition-colors hover:text-accent-dim">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-3 sm:gap-5">
      <a
        href={`tel:${site.phoneTel}`}
        class="hidden min-h-11 items-center gap-2 font-mono text-sm font-semibold whitespace-nowrap text-ink sm:flex"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4 flex-none" aria-hidden="true">
          <path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z"></path>
        </svg>
        <span class="sr-only">Call us at </span>{site.phone}
      </a>
      <a
        href={contactHref}
        class="hidden min-h-11 items-center border-2 border-transparent bg-accent px-5 py-2.5 text-sm font-semibold text-ink transition-colors hover:bg-accent-hover md:inline-flex"
      >
        Request a visit
      </a>
      <details class="mobile-menu relative lg:hidden">
        <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 border border-line px-3 text-sm font-semibold text-ink">
          <span>Menu</span>
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" class="h-4 w-4" aria-hidden="true">
            <path d="M3 5h14M3 10h14M3 15h14"></path>
          </svg>
        </summary>
        <nav
          aria-label="Mobile sections"
          class="absolute top-[calc(100%+0.75rem)] right-0 w-[min(19rem,calc(100vw-2.5rem))] border border-line bg-white p-2 shadow-[0_16px_36px_rgba(20,20,32,0.16)]"
        >
          <ul>
            {nav.map((item) => (
              <li class="border-b border-line last:border-b-0">
                <a href={item.href} class="flex min-h-11 items-center px-3 text-sm font-semibold text-ink hover:bg-lavender-tint">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLDetailsElement>(".mobile-menu").forEach((menu) => {
    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => menu.removeAttribute("open"));
    });
  });
</script>

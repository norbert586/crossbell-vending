---
// Front elevation of a wall-mount trading card machine, drawn rather than
// photographed: the exact unit is chosen per venue, and drawn packs keep the
// page clear of anyone else's artwork. Generic foil packs, Crossbell colors.
//
// The sheen sweep is decoration. It runs on a slow loop and is switched off
// for reduced motion (global.css).
interface Props {
  class?: string;
  /** Prefix for the SVG's internal ids. Set a different one if the art appears twice on a page. */
  idPrefix?: string;
}
const { class: className, idPrefix = "cm" } = Astro.props;
const id = (name: string) => `${idPrefix}-${name}`;

const cols = [0, 1, 2];
const rows = [0, 1, 2];
// One foil per slot, read left to right, top to bottom.
const foils = ["gold", "violet", "lav", "violet", "lav", "gold", "lav", "gold", "violet"];
const slotX = (c: number) => 46 + c * 82;
const slotY = (r: number) => 92 + r * 112;
const code = (r: number, c: number) => `${"ABC"[r]}${c + 1}`;

// A foil pack outline: straight sides, crimped (zigzag) top and bottom.
const PACK_W = 58;
const PACK_H = 78;
const pack = (x: number, y: number, w = PACK_W, h = PACK_H, teeth = 8, depth = 3.5) => {
  const step = w / teeth;
  let d = `M${x} ${y + depth}`;
  for (let i = 0; i < teeth; i++) d += ` l${step / 2} ${-depth} l${step / 2} ${depth}`;
  d += ` L${x + w} ${y + h - depth}`;
  for (let i = 0; i < teeth; i++) d += ` l${-step / 2} ${depth} l${-step / 2} ${-depth}`;
  return d + "Z";
};
// A diagonal sheen band across a pack.
const streak = (x: number, y: number, w = PACK_W, h = PACK_H) =>
  `M${x} ${y + h * 0.62} L${x + w} ${y + h * 0.3} L${x + w} ${y + h * 0.44} L${x} ${y + h * 0.76}Z`;
---

<svg
  viewBox="0 0 420 520"
  role="img"
  aria-labelledby={id("title")}
  class:list={["card-machine-art", className]}
>
  <title id={id("title")}>
    Illustration of a wall-mounted trading card vending machine: nine slots of sealed booster packs behind glass,
    a tap-to-pay reader, and a pickup bin.
  </title>
  <defs>
    <linearGradient id={id("foil-gold")} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f3d79c" />
      <stop offset="0.45" stop-color="#c49350" />
      <stop offset="1" stop-color="#8a5f27" />
    </linearGradient>
    <linearGradient id={id("foil-violet")} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#8f86f0" />
      <stop offset="0.5" stop-color="#4b3fa8" />
      <stop offset="1" stop-color="#2a2a5c" />
    </linearGradient>
    <linearGradient id={id("foil-lav")} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffffff" />
      <stop offset="0.4" stop-color="#cdd1ff" />
      <stop offset="1" stop-color="#7f86d6" />
    </linearGradient>
    <linearGradient id={id("glass")} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#23234a" />
      <stop offset="1" stop-color="#1a1a36" />
    </linearGradient>
    <linearGradient id={id("sheen")} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity="0" />
      <stop offset="0.5" stop-color="#fff" stop-opacity="0.22" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <clipPath id={id("window-clip")}>
      <rect x="34" y="78" width="258" height="344" rx="4" />
    </clipPath>
  </defs>

  <!-- Wall shadow and cabinet -->
  <rect x="22" y="26" width="384" height="476" rx="14" fill="#000" opacity="0.18" transform="translate(6 8)" />
  <rect x="18" y="20" width="384" height="476" rx="14" fill="#141420" stroke="#3b3b75" stroke-width="2" />
  <rect x="18" y="20" width="384" height="44" rx="14" fill="#c49350" />
  <rect x="18" y="48" width="384" height="16" fill="#c49350" />
  <text x="34" y="49" class="font-mono" font-size="15" font-weight="700" letter-spacing="2" fill="#141420">CROSSBELL CARDS</text>
  <g fill="#141420">
    <circle cx="372" cy="43" r="4" />
    <circle cx="356" cy="43" r="4" opacity="0.45" />
  </g>

  <!-- Glass window with three shelves of packs -->
  <rect x="34" y="78" width="258" height="344" rx="4" fill={`url(#${id("glass")})`} stroke="#3b3b75" stroke-width="2" />
  <g clip-path={`url(#${id("window-clip")})`}>
    {rows.map((r) => (
      <g>
        {cols.map((c) => {
          const x = slotX(c);
          const y = slotY(r);
          const foil = foils[r * 3 + c];
          return (
            <g>
              <path d={pack(x + 7, y - 5)} fill={`url(#${id(`foil-${foil}`)})`} opacity="0.4" />
              <path d={pack(x, y)} fill={`url(#${id(`foil-${foil}`)})`} stroke="#141420" stroke-opacity="0.25" />
              <path d={streak(x, y)} fill="#fff" fill-opacity="0.16" />
              <rect x={x + 6} y={y + 9} width={PACK_W - 12} height="1.5" fill="#141420" fill-opacity="0.22" />
              <rect x={x + 6} y={y + PACK_H - 11} width={PACK_W - 12} height="1.5" fill="#141420" fill-opacity="0.22" />
              <circle cx={x + 29} cy={y + 37} r="13" fill="#fff" fill-opacity="0.2" />
              <path
                d={`M${x + 29} ${y + 26} l3 8 8 3 -8 3 -3 8 -3 -8 -8 -3 8 -3Z`}
                fill="#fff"
                fill-opacity="0.9"
              />
              <rect x={x + 12} y={y + 56} width="34" height="4" rx="1" fill="#141420" fill-opacity="0.3" />
            </g>
          );
        })}
        <rect x="34" y={slotY(r) + 84} width="258" height="3" fill="#3b3b75" />
        {cols.map((c) => (
          <g>
            <path
              d={`M${slotX(c) - 2} ${slotY(r) + 82} q5 -7 10 0 q5 -7 10 0 q5 -7 10 0 q5 -7 10 0 q5 -7 10 0 q5 -7 10 0`}
              fill="none"
              stroke="#9ea2d6"
              stroke-width="1.6"
            />
            <rect x={slotX(c) + 15} y={slotY(r) + 90} width="28" height="12" rx="1.5" fill="#f6f7ff" />
            <text
              x={slotX(c) + 29}
              y={slotY(r) + 99}
              text-anchor="middle"
              class="font-mono"
              font-size="9"
              font-weight="700"
              fill="#141420">{code(r, c)}</text>
          </g>
        ))}
      </g>
    ))}
    <rect class="card-machine-sheen" x="-120" y="78" width="110" height="344" fill={`url(#${id("sheen")})`} transform="skewX(-14)" />
  </g>

  <!-- Payment column -->
  <rect x="306" y="78" width="82" height="344" rx="4" fill="#1d1d3c" stroke="#3b3b75" stroke-width="2" />
  <rect x="318" y="92" width="58" height="40" rx="3" fill="#cdd1ff" />
  <text x="347" y="109" text-anchor="middle" class="font-mono" font-size="8" font-weight="700" fill="#2a2a5c">PICK A</text>
  <text x="347" y="121" text-anchor="middle" class="font-mono" font-size="8" font-weight="700" fill="#2a2a5c">SLOT</text>
  <g fill="#3b3b75" stroke="#5b5b96" stroke-width="1">
    {[0, 1, 2, 3].map((r) => [0, 1, 2].map((c) => <rect x={320 + c * 19} y={144 + r * 17} width="15" height="12" rx="2" />))}
  </g>
  <rect x="318" y="226" width="58" height="76" rx="6" fill="#141420" stroke="#c49350" stroke-width="2" />
  <g fill="none" stroke="#c49350" stroke-width="2" stroke-linecap="round">
    <path d="M338 252 q6 12 0 24" />
    <path d="M345 247 q9 17 0 34" />
    <path d="M352 242 q12 22 0 44" />
  </g>
  <text x="347" y="318" text-anchor="middle" class="font-mono" font-size="8" font-weight="700" fill="#9ea2d6" letter-spacing="1">TAP TO PAY</text>
  <rect x="330" y="334" width="34" height="6" rx="3" fill="#3b3b75" />
  <circle cx="347" cy="372" r="11" fill="none" stroke="#3b3b75" stroke-width="2" />
  <circle cx="347" cy="372" r="3" fill="#c49350" />

  <!-- Pickup bin -->
  <rect x="34" y="436" width="354" height="46" rx="4" fill="#0d0d18" stroke="#3b3b75" stroke-width="2" />
  <rect x="120" y="446" width="182" height="26" rx="3" fill="#1d1d3c" stroke="#5b5b96" stroke-width="1.5" />
  <text x="211" y="463" text-anchor="middle" class="font-mono" font-size="9" font-weight="700" letter-spacing="2" fill="#9ea2d6">PUSH</text>
</svg>

<style>
  .card-machine-sheen {
    animation: card-machine-sheen 7s ease-in-out 1.2s infinite;
  }

  @keyframes card-machine-sheen {
    0% {
      transform: skewX(-14deg) translateX(0);
    }
    35%,
    100% {
      transform: skewX(-14deg) translateX(560px);
    }
  }
</style>

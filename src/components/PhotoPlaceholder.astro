---
interface Props {
  shotId: string;
  label: string;
  aspect: string; // e.g. "4/5", "16/9"
  class?: string;
}
const { shotId, label, aspect, class: className = "" } = Astro.props;
---

<figure
  class={`flex flex-col items-center justify-center gap-3 border border-dashed border-line bg-lavender-tint p-6 text-center ${className}`}
  style={`aspect-ratio: ${aspect};`}
>
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    class="h-8 w-8 text-muted"
    aria-hidden="true"
  >
    <path
      d="M4 8h3l1.5-2h7L17 8h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Z"
    ></path>
    <circle cx="12" cy="13.5" r="3.5"></circle>
  </svg>
  <figcaption class="max-w-[26ch] text-sm text-muted">
    {label}
    <span class="mt-1 block font-mono text-xs tracking-tight text-muted"
      >Shot {shotId} &middot; {aspect} &middot; see README</span
    >
  </figcaption>
</figure>

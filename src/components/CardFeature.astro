---
import { Image } from "astro:assets";
import { cardMachines, cardInquiry } from "../data/cardMachines";

interface Props { pageHero?: boolean; id?: string; }
const { pageHero = false, id = "card-machines" } = Astro.props;
const Heading = pageHero ? "h1" : "h2";
const featured = cardMachines[1];
---

<section id={id} class:list={["tcg-feature bg-ink", { "tcg-feature--hero": pageHero }]} aria-labelledby={`${id}-heading`}>
  <div class="tcg-feature__inner">
    <div class="tcg-feature__copy">
      <Heading id={`${id}-heading`} class="tcg-feature__heading">Trading cards.<br /><span>A standout amenity.</span></Heading>
      <p class="tcg-feature__description">Pokémon and other trading-card favorites, in a machine sized for your venue. Installed, restocked weekly, and serviced by Crossbell.</p>
      <div class="tcg-feature__actions">
        <a class="cb-button" href={pageHero ? cardInquiry() : "/trading-card-vending/"}>
          {pageHero ? "Request a site visit" : "Explore card machines"}<span aria-hidden="true">&rarr;</span>
        </a>
        <a class="tcg-link" href={pageHero ? "#lineup" : cardInquiry()}>{pageHero ? "See all models" : "Ask about your venue"}</a>
      </div>
      <p class="tcg-feature__offer">Free placement, stocking, and service for qualifying venues.</p>
    </div>
    <figure class="tcg-feature__visual">
      <div class="tcg-foil">
        <div class="tcg-feature__stage">
          <Image src={featured.image} alt="AI product visualization of the Youmi YM102 trading-card vending machine with a red-and-white Poké Ball design" widths={[400, 640, 900]} sizes="(min-width: 900px) 430px, 85vw" class="tcg-feature__machine" loading={pageHero ? "eager" : "lazy"} fetchpriority={pageHero ? "high" : "auto"} />
          <span class="tcg-feature__seal">Sealed packs.<br />Fresh possibilities.</span>
        </div>
      </div>
      <figcaption>Youmi YM102 &middot; AI product visualization</figcaption>
    </figure>
  </div>
  <div class="tcg-feature__footer" aria-label="Trading-card service benefits">
    <span>Pokémon &amp; more TCGs</span><span>Weekly restocks</span><span>Card &amp; mobile payments</span>
  </div>
</section>

<style>
  .tcg-feature { color: var(--color-paper); overflow: hidden; scroll-margin-top: 5rem; }
  .tcg-feature__inner { max-width: 1120px; margin: auto; padding: 4.5rem 2rem 3rem; display: grid; grid-template-columns: 1.15fr 1fr; gap: 4rem; align-items: center; }
  .tcg-feature__heading { font-size: clamp(2.7rem, 4.8vw, 4.8rem); font-weight: 700; line-height: .98; max-width: 14ch; }
  .tcg-feature__heading span { color: var(--color-lavender); }
  .tcg-feature__description { color: var(--color-lavender); font-size: 1.05rem; line-height: 1.75; max-width: 43ch; margin-top: 1.6rem; }
  .tcg-feature__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 2rem; }
  .tcg-feature__offer { font-size: .8rem; line-height: 1.6; color: var(--color-lavender); margin-top: 1rem; max-width: 43ch; }
  .tcg-feature__visual { width: 100%; max-width: 430px; justify-self: end; }
  .tcg-foil { padding: 2px; border-radius: 16px; background: linear-gradient(135deg, var(--color-accent), var(--color-lavender) 24%, var(--color-indigo-2) 50%, var(--color-lavender) 75%, var(--color-accent)); box-shadow: 0 24px 60px rgb(0 0 0 / .25); }
  .tcg-feature__stage { background: radial-gradient(ellipse at 48% 40%, var(--color-indigo-2), var(--color-ink) 72%); border-radius: 14px; min-height: 0; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .tcg-feature__machine { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: contain; position: relative; z-index: 1; transition: transform 700ms cubic-bezier(.16,1,.3,1); }
  .tcg-feature__stage::after { content: ""; position: absolute; inset: -60%; background: linear-gradient(115deg, transparent 43%, rgb(205 209 255 / .04) 47%, rgb(255 255 255 / .14) 50%, rgb(196 147 80 / .06) 53%, transparent 57%); transform: translateX(-65%); pointer-events: none; z-index: 2; }
  .tcg-feature__seal { position: absolute; bottom: 1rem; left: 1rem; z-index: 3; padding: .65rem .85rem; background: var(--color-ink); border: 1px solid var(--color-accent); border-radius: 3px; color: var(--color-paper); font-size: .72rem; line-height: 1.5; }
  .tcg-feature__visual figcaption { font-size: .68rem; color: var(--color-lavender); text-align: center; line-height: 1.5; margin-top: .85rem; }
  .tcg-feature__footer { max-width: 1056px; margin: 0 auto; padding: 1.4rem 0; border-top: 1px solid var(--color-indigo-2); display: flex; justify-content: space-between; gap: 1rem; font-size: .85rem; color: var(--color-lavender); }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .tcg-feature__visual:hover .tcg-feature__machine { transform: scale(1.015); }
    .tcg-feature__visual:hover .tcg-feature__stage::after { animation: foil-sweep 1100ms cubic-bezier(.16,1,.3,1) both; }
  }
  @keyframes foil-sweep { to { transform: translateX(65%); } }
  @media (max-width: 899px) {
    .tcg-feature__inner { padding: 3.5rem 1.25rem 2rem; grid-template-columns: 1fr; gap: 2rem; }
    .tcg-feature__heading { font-size: clamp(2.7rem, 8vw, 4.5rem); max-width: 20ch; }
    .tcg-feature__description { max-width: 56ch; }
    .tcg-feature__visual { max-width: 400px; justify-self: center; }
    .tcg-feature__stage { min-height: 0; }
    .tcg-feature__machine { height: auto; }
    .tcg-feature__footer { margin: 0 1.25rem; flex-wrap: wrap; justify-content: center; column-gap: 1.5rem; font-size: .75rem; }
  }
  @media (prefers-reduced-motion: reduce) { .tcg-feature__machine { transition: none; } }
</style>

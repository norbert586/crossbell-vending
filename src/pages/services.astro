---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import ContactSection from "../components/ContactSection.astro";
import FaqItem from "../components/FaqItem.astro";
import ServiceAreaSection from "../components/ServiceAreaSection.astro";
import CardFeature from "../components/CardFeature.astro";
import { site } from "../data/site";
import { machines } from "../data/machines";
import plus440 from "../assets/machines/plus-440-angle.jpg";
import ultra1200 from "../assets/machines/ultra-1200-angle.jpg";
import max620Cut from "../assets/machines/cut/max-620.jpg";
import ultra1200Cut from "../assets/machines/cut/ultra-1200.jpg";
import freezer550Cut from "../assets/machines/cut/freezer-550.jpg";

const title = "Smart Coolers, Smart Markets & Trading Card Machines | Crossbell Vending";
const description =
  "Smart cooler vending, secure smart markets, and trading card machines, installed, stocked, and serviced by Crossbell Vending across Macomb and north Oakland County, Michigan.";

const areaServed = site.serviceArea
  .flatMap((entry) => entry.name.split("/").map((city) => city.trim()))
  .map((city) => ({ "@type": "City", name: `${city}, MI` }));

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${site.url}/services/#managed-smart-vending`,
  name: "Managed smart vending service",
  serviceType: "Smart cooler, smart market, and trading card machine installation, stocking, and service",
  description,
  url: `${site.url}/services/`,
  provider: { "@id": `${site.url}/#organization` },
  areaServed,
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Vending formats",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Smart cooler vending",
          description: "A single secure, cashless smart cooler installed, stocked, and serviced by Crossbell Vending.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Smart market service",
          description: "A coordinated group of secure smart coolers and freezers managed as one onsite market.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Trading card vending machine",
          description:
            "A compact, cashless trading card machine stocked with factory-sealed booster packs, placed and serviced by Crossbell Vending.",
        },
      },
    ],
  },
};

// The three formats, in the order the page explains them.
const formats = [
  {
    id: "smart-cooler",
    label: "Format 01",
    name: "Smart cooler",
    body: "One secure glass-door cooler with automatic checkout. It gives a break room, gym, lobby, or waiting area a real selection without taking over the wall.",
    href: "#cooler-detail",
    linkText: "How a single cooler works",
    facts: [
      ["Size", `${Math.min(...machines.map((m) => m.footprint.w))} to ${Math.max(...machines.map((m) => m.footprint.w))} in wide`],
      ["Best for", "Break rooms, gyms, lobbies"],
    ],
  },
  {
    id: "smart-market",
    label: "Format 02",
    name: "Smart market",
    body: "Two or more coolers and freezers run as one onsite store, with room for fresh food, frozen meals, and the essentials your site keeps asking for.",
    href: "#market-detail",
    linkText: "How a market comes together",
    facts: [
      ["Size", "Two doors and up"],
      ["Best for", "Busy, multi-shift sites"],
    ],
  },
  {
    id: "card-machine",
    label: "Format 03",
    name: "Trading card machine",
    isNew: true,
    body: "Pokémon and other TCG packs in touchscreen machines, from compact wall mounts to a full-height tower. Stocked weekly and serviced by Crossbell.",
    href: "/trading-card-vending/",
    linkText: "Explore trading-card vending",
    facts: [
      ["Size", "Wall mount or freestanding"],
      ["Best for", "Rinks, bowling, family venues"],
    ],
  },
];

// The example market bay, drawn to scale from the trimmed front photos.
const bay = [
  { label: "Cooler", slug: "max-620", photo: max620Cut },
  { label: "Double-door cooler", slug: "ultra-1200", photo: ultra1200Cut },
  { label: "Freezer", slug: "freezer-550", photo: freezer550Cut },
].map((b) => ({ ...b, machine: machines.find((m) => m.slug === b.slug)! }));
const bayWidth = bay.reduce((sum, b) => sum + b.machine.footprint.w, 0);
const bayFeet = Math.round((bayWidth / 12) * 2) / 2;


---

<Layout title={title} description={description} contactHref="#contact" schema={serviceSchema}>
  <section class="overflow-hidden bg-indigo text-paper">
    <div class="grid lg:grid-cols-2">
      <div class="flex flex-col justify-center px-5 py-14 sm:px-8 sm:py-20 lg:min-h-[640px] lg:py-20 lg:pr-14 lg:pl-[max(2rem,calc((100vw-1120px)/2+2rem))] xl:min-h-[680px]">
        <a
          href="#card-machines"
          class="group inline-flex items-center gap-2.5 self-start border border-lavender/40 py-1 pr-3 pl-1 text-sm font-medium text-white transition-colors hover:border-accent"
        >
          <span class="bg-accent px-2 py-0.5 font-mono text-[0.66rem] font-bold tracking-[0.12em] text-ink uppercase">New</span>
          Trading card machines
          <span aria-hidden="true" class="text-accent transition-transform group-hover:translate-x-0.5">&rarr;</span>
        </a>
        <h1 class="mt-6 max-w-[15ch] text-[clamp(2.7rem,4.3vw,4.15rem)] font-bold leading-[0.98] text-white">
          Coolers, markets, and now trading card machines.
        </h1>
        <p class="mt-6 max-w-[46ch] text-lg leading-relaxed text-lavender">
          Pick the format that fits the room and the people in it. Crossbell installs it, stocks it,
          watches it remotely, and services it on our weekly Macomb and north Oakland route.
        </p>
        <div class="mt-8 flex flex-wrap gap-3.5">
          <a
            href="#contact"
            class="inline-flex min-h-11 items-center rounded-[3px] bg-accent px-6 py-3.5 text-sm font-semibold text-ink transition-colors hover:bg-accent-hover"
          >
            Request a site visit
          </a>
          <a
            href="#compare"
            class="inline-flex min-h-11 items-center rounded-[3px] border-2 border-lavender px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-white hover:text-indigo"
          >
            Compare the formats
          </a>
        </div>
        <p class="mt-4 text-sm text-lavender">No cost to qualifying locations.</p>
      </div>

      <div class="relative border-t border-indigo-2 bg-white px-5 pt-10 pb-7 text-ink sm:px-10 lg:min-h-[640px] lg:border-t-0 lg:border-l lg:pt-10 lg:pr-[max(2rem,calc((100vw-1120px)/2+2rem))] lg:pb-8 lg:pl-14 xl:min-h-[680px]">
        <div class="absolute top-0 left-0 bg-accent px-4 py-2 font-mono text-[0.68rem] font-bold tracking-[0.16em] text-ink uppercase">
          Ultra 1200 · two doors
        </div>
        <div class="flex min-h-[360px] items-end justify-center pt-7 sm:min-h-[500px]">
          <Image
            src={ultra1200}
            alt="Two-door smart cooler shown at a three-quarter angle"
            widths={[520, 760, 1000]}
            sizes="(min-width: 1024px) 46vw, 90vw"
            class="h-auto max-h-[430px] w-full object-contain"
            loading="eager"
            decoding="sync"
            fetchpriority="high"
          />
        </div>
        <div class="relative mt-2 border-t-2 border-ink pt-4">
          <span class="absolute -top-2 left-0 h-4 border-l-2 border-ink"></span>
          <span class="absolute -top-2 right-0 h-4 border-r-2 border-ink"></span>
          <div class="flex items-start justify-between gap-6 font-mono text-[0.68rem] font-semibold tracking-[0.08em] uppercase">
            <span>53.9 in cabinet width</span>
            <span class="text-right text-accent-dim">Tap · take · close</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-accent text-ink" aria-label="Service commitments">
    <dl class="mx-auto grid max-w-[1120px] divide-y divide-ink/20 px-5 sm:grid-cols-3 sm:divide-x sm:divide-y-0 sm:px-8">
      <div class="py-6 sm:pr-8">
        <dt class="font-display text-2xl font-bold">One local operator</dt>
        <dd class="mt-1 text-sm font-medium">The people who answer the phone also run the route.</dd>
      </div>
      <div class="py-6 sm:px-8">
        <dt class="font-display text-2xl font-bold">Watched between visits</dt>
        <dd class="mt-1 text-sm font-medium">Every machine reports its sales, so low items are caught early.</dd>
      </div>
      <div class="py-6 sm:pl-8">
        <dt class="font-display text-2xl font-bold">Right-sized first</dt>
        <dd class="mt-1 text-sm font-medium">We recommend the smallest setup that serves the site well.</dd>
      </div>
    </dl>
  </section>

  <section id="compare" class="scroll-mt-20 py-14 sm:py-20" aria-labelledby="format-heading">
    <div class="mx-auto max-w-[1120px] px-5 sm:px-8">
      <div class="max-w-[60ch]">
        <h2 id="format-heading" class="text-[clamp(2rem,3.8vw,3rem)] font-semibold">Which format fits your site?</h2>
        <p class="mt-4 text-[1.04rem] leading-relaxed text-muted">
          All three take cards and phones, and all three are serviced on the same Crossbell route.
          The difference is what they sell and how much room they need.
        </p>
      </div>

      <div class="mt-10 border-y-2 border-ink">
        {formats.map((f, i) => (
          <article
            id={f.id}
            class:list={[
              "grid scroll-mt-24 gap-5 py-7 md:grid-cols-[110px_1fr_250px] md:items-start md:gap-8",
              { "border-b border-line": i < formats.length - 1 },
            ]}
          >
            <div class="flex items-center gap-2 font-mono text-sm font-bold text-accent-dim uppercase md:block">
              {f.label}
              {f.isNew && (
                <span class="bg-indigo px-1.5 py-0.5 font-mono text-[0.62rem] font-bold tracking-[0.12em] text-white md:mt-2 md:table">
                  NEW
                </span>
              )}
            </div>
            <div>
              <h3 class="text-[clamp(1.65rem,3vw,2.2rem)] font-semibold">{f.name}</h3>
              <p class="mt-2 max-w-[58ch] text-muted">{f.body}</p>
              <a href={f.href} class="mt-4 inline-flex text-sm font-semibold underline decoration-accent decoration-2 underline-offset-4">
                {f.linkText} <span aria-hidden="true" class="ml-1">&darr;</span>
              </a>
            </div>
            <dl class="grid grid-cols-2 gap-4 md:grid-cols-1 md:border-l md:border-line md:pl-6">
              {f.facts.map(([term, value]) => (
                <div>
                  <dt class="text-xs font-semibold text-muted">{term}</dt>
                  <dd class="mt-0.5 font-semibold">{value}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="cooler-detail" class="scroll-mt-20 bg-lavender-tint py-14 sm:py-20">
    <div class="mx-auto grid max-w-[1120px] gap-10 px-5 sm:px-8 md:grid-cols-[0.82fr_1.18fr] md:items-center">
      <figure class="border border-line bg-white p-5 sm:p-8">
        <Image
          src={plus440}
          alt="Single-door smart cooler shown at a three-quarter angle"
          widths={[460, 720, 900]}
          sizes="(min-width: 768px) 38vw, 90vw"
          class="mx-auto aspect-[3/4] max-h-[520px] w-full object-cover"
          loading="lazy"
        />
        <figcaption class="mt-4 border-t border-line pt-3 font-mono text-[0.68rem] font-semibold tracking-[0.1em] text-muted uppercase">
          Plus 440 · 26.8 in wide
        </figcaption>
      </figure>
      <div>
        <p class="font-mono text-sm font-bold text-accent-dim uppercase">Format 01 · Smart cooler</p>
        <h2 class="mt-2 text-[clamp(2rem,3.8vw,3rem)] font-semibold">A small store behind one door.</h2>
        <p class="mt-4 max-w-[56ch] text-[1.04rem] leading-relaxed text-muted">
          Customers tap a card or phone to unlock it, take one item or several, and close the door.
          The cooler records what left and completes the purchase on its own. No coils, no barcode
          scanning, no separate kiosk.
        </p>
        <dl class="mt-7 grid gap-x-8 gap-y-5 border-t border-line pt-6 sm:grid-cols-2">
          <div><dt class="text-sm font-semibold">Selection</dt><dd class="mt-1 text-muted">Cold drinks, snacks, protein, fresh options, and premium items.</dd></div>
          <div><dt class="text-sm font-semibold">Checkout</dt><dd class="mt-1 text-muted">Credit or debit card, Apple Pay, and Google Pay.</dd></div>
          <div><dt class="text-sm font-semibold">Site needs</dt><dd class="mt-1 text-muted">A level indoor spot, service access, and one standard outlet.</dd></div>
          <div><dt class="text-sm font-semibold">Service</dt><dd class="mt-1 text-muted">Weekly route visits, with remote inventory checks in between.</dd></div>
        </dl>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="/machines/" class="inline-flex min-h-11 items-center rounded-[3px] bg-accent px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-accent-hover">
            Compare cooler sizes
          </a>
          <a href="/contact/?service=smart-cooler" class="text-sm font-semibold underline decoration-accent decoration-2 underline-offset-4">
            Ask about a cooler
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-indigo py-14 text-paper sm:py-20" aria-labelledby="checkout-heading">
    <div class="mx-auto max-w-[1120px] px-5 sm:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="checkout-heading" class="text-[clamp(2rem,3.8vw,3rem)] font-semibold text-white">How checkout works</h2>
        <p class="max-w-[40ch] text-lavender">The same four steps at every cooler and freezer door. Nobody has to learn a kiosk.</p>
      </div>
      <ol class="mt-10 grid border-y border-indigo-2 sm:grid-cols-4 sm:divide-x sm:divide-indigo-2">
        <li class="border-b border-indigo-2 py-6 sm:border-b-0 sm:px-5 sm:first:pl-0">
          <div class="font-display text-2xl font-semibold text-accent">1. Tap</div><p class="mt-1.5 text-sm text-lavender">Tap a card or phone at the reader.</p>
        </li>
        <li class="border-b border-indigo-2 py-6 sm:border-b-0 sm:px-5">
          <div class="font-display text-2xl font-semibold text-accent">2. Open</div><p class="mt-1.5 text-sm text-lavender">The door unlocks once the card is approved.</p>
        </li>
        <li class="border-b border-indigo-2 py-6 sm:border-b-0 sm:px-5">
          <div class="font-display text-2xl font-semibold text-accent">3. Take</div><p class="mt-1.5 text-sm text-lavender">Grab one item or several in the same visit.</p>
        </li>
        <li class="py-6 sm:pr-0 sm:pl-5">
          <div class="font-display text-2xl font-semibold text-accent">4. Close</div><p class="mt-1.5 text-sm text-lavender">The cooler tallies what left and charges for exactly that.</p>
        </li>
      </ol>
    </div>
  </section>

  <section id="market-detail" class="scroll-mt-20 py-14 sm:py-20">
    <div class="mx-auto max-w-[1120px] px-5 sm:px-8">
      <div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:items-end">
        <div class="pb-1">
          <p class="font-mono text-sm font-bold text-accent-dim uppercase">Format 02 · Smart market</p>
          <h2 class="mt-2 text-[clamp(2rem,3.8vw,3rem)] font-semibold">Build the market one bay at a time.</h2>
          <p class="mt-4 max-w-[50ch] text-[1.04rem] leading-relaxed text-muted">
            A smart market is a set of coolers and freezers chosen for the room and run as one
            Crossbell stop. Each door has its own checkout, so there is no central kiosk to staff
            or wait in line for.
          </p>
          <p class="mt-4 max-w-[50ch] text-muted">
            Most sites start with one or two doors and add more once the sales show they need it.
            That keeps the wall useful instead of filled for show.
          </p>
        </div>

        <figure class="border-2 border-ink bg-white">
          <div class="flex items-center justify-between gap-4 border-b border-line px-4 py-3">
            <span class="font-mono text-[0.68rem] font-bold tracking-[0.14em] uppercase">Example bay, to scale</span>
            <span class="font-mono text-[0.68rem] font-semibold text-accent-dim uppercase">About {bayFeet} ft of wall</span>
          </div>
          <div class="px-4 pt-6 sm:px-7">
            <div class="flex items-end gap-2 border-b-2 border-ink sm:gap-3">
              {bay.map((b) => (
                <div class="min-w-0" style={`flex: ${b.machine.footprint.w} 1 0`}>
                  <Image
                    src={b.photo}
                    alt={`${b.machine.name} ${b.label.toLowerCase()}`}
                    widths={[160, 320, 480]}
                    sizes="(min-width: 1024px) 260px, 30vw"
                    class="block h-auto w-full mix-blend-multiply"
                    style={`aspect-ratio: ${b.machine.footprint.w} / ${b.machine.footprint.h}; object-fit: fill`}
                    loading="lazy"
                  />
                </div>
              ))}
            </div>
            <div class="flex gap-2 pt-2.5 pb-4 sm:gap-3">
              {bay.map((b) => (
                <div class="min-w-0" style={`flex: ${b.machine.footprint.w} 1 0`}>
                  <div class="truncate text-[0.8rem] font-semibold sm:text-sm">{b.label}</div>
                  <div class="font-mono text-[0.66rem] text-muted">{b.machine.footprint.w}"</div>
                </div>
              ))}
            </div>
          </div>
          <figcaption class="border-t-2 border-ink px-4 py-3 text-sm text-muted">
            One example, not a package. The final mix depends on space, traffic, shifts, and what
            people buy.
          </figcaption>
        </figure>
      </div>

      <div class="mt-10 grid gap-px border border-line bg-line sm:grid-cols-2 md:grid-cols-4">
        <div class="bg-paper p-5"><h3 class="font-body text-base font-semibold">Drinks</h3><p class="mt-1.5 text-sm text-muted">Water, soda, energy, sports drinks, juice, and cold brew.</p></div>
        <div class="bg-paper p-5"><h3 class="font-body text-base font-semibold">Snacks</h3><p class="mt-1.5 text-sm text-muted">Everyday favorites, protein, better-for-you choices, and local requests.</p></div>
        <div class="bg-paper p-5"><h3 class="font-body text-base font-semibold">Fresh and frozen</h3><p class="mt-1.5 text-sm text-muted">Ready-to-eat options and frozen meals where the site supports them.</p></div>
        <div class="bg-paper p-5"><h3 class="font-body text-base font-semibold">Site essentials</h3><p class="mt-1.5 text-sm text-muted">Personal care, convenience, or premium items picked for the people there.</p></div>
      </div>

      <aside class="mt-8 grid gap-4 border border-line bg-lavender-tint p-5 sm:p-7 md:grid-cols-[180px_1fr] md:gap-8">
        <h3 class="font-body text-base font-semibold">Why “smart market”?</h3>
        <p class="text-[0.98rem] leading-relaxed text-muted">
          A traditional micro market puts products on open shelves and checks people out at a
          central kiosk. A Crossbell smart market keeps everything inside locked coolers and
          freezers, and checkout happens at each door. You get the selection without an open
          retail floor.
        </p>
      </aside>

      <div class="mt-8">
        <a href="/contact/?service=smart-market" class="inline-flex min-h-11 items-center rounded-[3px] bg-accent px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-accent-hover">
          Ask about a smart market
        </a>
      </div>
    </div>
  </section>

  <CardFeature id="card-machines" />

  <section id="responsibilities" class="scroll-mt-20 py-14 sm:py-20" aria-labelledby="responsibility-heading">
    <div class="mx-auto max-w-[1120px] px-5 sm:px-8">
      <div class="max-w-[58ch]">
        <h2 id="responsibility-heading" class="text-[clamp(2rem,3.8vw,3rem)] font-semibold">Who does what</h2>
        <p class="mt-3 text-muted">The same split for every format. You hand us the spot; we handle the rest.</p>
      </div>
      <div class="mt-9 grid border-2 border-ink md:grid-cols-2 md:divide-x md:divide-ink">
        <div class="p-6 sm:p-8">
          <h3 class="font-body text-lg font-semibold">Crossbell handles</h3>
          <ul class="mt-5 grid gap-3 text-muted sm:grid-cols-2">
            <li class="border-t border-line pt-3">Equipment and delivery</li>
            <li class="border-t border-line pt-3">Installation and setup</li>
            <li class="border-t border-line pt-3">Product selection</li>
            <li class="border-t border-line pt-3">Stocking and rotation</li>
            <li class="border-t border-line pt-3">Remote inventory checks</li>
            <li class="border-t border-line pt-3">Cleaning, service, and repairs</li>
          </ul>
        </div>
        <div class="border-t-2 border-ink bg-lavender-tint p-6 sm:p-8 md:border-t-0">
          <h3 class="font-body text-lg font-semibold">Your location provides</h3>
          <ul class="mt-5 grid gap-3 text-muted sm:grid-cols-2">
            <li class="border-t border-line pt-3">A suitable indoor space</li>
            <li class="border-t border-line pt-3">Standard wall power</li>
            <li class="border-t border-line pt-3">Access for route service</li>
            <li class="border-t border-line pt-3">Enough daily use to support the setup</li>
            <li class="border-t border-line pt-3 sm:col-span-2">Honest feedback about what people want stocked</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <ServiceAreaSection />

  <section id="faq" class="scroll-mt-20 py-14 sm:py-20">
    <div class="mx-auto max-w-[880px] px-5 sm:px-8">
      <h2 class="text-[clamp(2rem,3.8vw,3rem)] font-semibold">Service questions</h2>
      <div class="mt-8 border-t border-line">
        <FaqItem question="What is the difference between a smart cooler and a smart market?">
          A smart cooler is one self-contained, cashless station. A smart market combines two or more
          coolers or freezers to carry a broader mix at a busier location. Either way, we manage the
          whole setup as one stop on our route.
        </FaqItem>
        <FaqItem question="Is this the same as an open-shelf micro market?">
          No. An open-shelf micro market uses open fixtures and a central self-checkout kiosk. A
          Crossbell smart market keeps products behind locked doors and handles checkout at each
          cabinet, which works better where open shelves or a separate kiosk are not practical.
        </FaqItem>
        <FaqItem question="Do you place trading card machines?">
          Yes. We offer all four VTM trading-card formats, from compact wall mounts to a freestanding
          tower. They carry Pokémon and other TCG packs, accept cards and mobile wallets, and are
          restocked weekly. They do best at bowling centers, rinks, family fun
          centers, sports facilities, and apartment clubhouses: anywhere families come back every
          week. Placement costs a qualifying venue nothing.
        </FaqItem>
        <FaqItem question="Are the card packs real and unopened?">
          Yes. We stock factory-sealed packs bought from sources we can document, and we
          keep the receipts. We never weigh, search, or reseal packs, and we don't sell homemade
          mystery bundles. Crossbell is an independent operator and is not affiliated with The
          Pokémon Company.
        </FaqItem>
        <FaqItem question="Does the host pay for the equipment or service?">
          Qualifying locations pay no equipment, delivery, stocking, or service charge. We confirm fit
          during the walkthrough, because a bigger setup needs enough regular traffic to stay fresh
          and useful.
        </FaqItem>
        <FaqItem question="How much space and power do we need?">
          A single cooler starts at 22.8 inches wide, and trading-card machines come in wall-mounted and freestanding
          formats. Larger coolers and multi-unit markets need more wall space. Every machine needs
          a standard outlet. We measure the spot, door swing, walking clearance, and outlet access
          before recommending anything.
        </FaqItem>
        <FaqItem question="What happens if a machine needs service?">
          Call or message Crossbell and we respond by the end of the business day. We handle
          refunds and repairs. If a cooler needs more than a quick fix, a replacement can be on
          site within 48 hours.
        </FaqItem>
        <FaqItem question="How long is the agreement?">
          After the first 90 days, thirty days’ written notice ends the agreement. An early-exit
          fee applies if you cancel within those first 90 days. The terms are explained before
          you sign.
        </FaqItem>
        <FaqItem question="Are you insured?">
          Yes. We are fully insured, with your business named as additional insured. A certificate
          is available on request.
        </FaqItem>
        <FaqItem question="Who decides what gets stocked?">
          We start with the site type, shift pattern, and expected traffic, then adjust from real sales
          and requests. We don't force the same planogram into every location; we stock what your
          people actually buy.
        </FaqItem>
      </div>
    </div>

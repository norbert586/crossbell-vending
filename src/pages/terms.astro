---
import LegalLayout from "../layouts/LegalLayout.astro";
import { site } from "../data/site";
---

<LegalLayout
  title="Terms of Use | Crossbell Vending"
  description="Terms governing use of the Crossbell Vending website."
  heading="Terms of use"
  updated="2026-09-12"
>
  <p>
    These terms govern your use of {site.domain} (the "site"), operated by {site.legalName}
    ("Crossbell Vending," "we," "us"). By using the site you agree to them. If you do not
    agree, please do not use the site.

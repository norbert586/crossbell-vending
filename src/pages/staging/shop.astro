---
import Layout from '../../layouts/Layout.astro';
const products = [
 {name:'Pokémon 30th Celebration',type:'Elite Trainer Box',category:'Pokémon',mark:'30',color:'#c49350'},
 {name:'Pokémon Ascended Heroes',type:'Elite Trainer Box',category:'Pokémon',mark:'AH',color:'#9e8bd0'},
 {name:'Riftbound Unleashed',type:'Individual booster pack',category:'Riftbound',mark:'R',color:'#78b9b0'}
];
---
<Layout title="Shop preview | Crossbell Vending" description="Crossbell trading card shop staging preview." noindex={true} actionBar={false}>
<div class="shop">
<div class="notice">STAGING PREVIEW · Orders and payments are disabled</div>
<section class="intro"><span class="eyebrow">CROSSBELL COLLECTIONS / TRADING CARDS</span><h1>Your next great pull<br/><em>starts here.</em></h1><p>Explore Pokémon Elite Trainer Boxes and Riftbound booster packs. Your collection. Your next chapter.</p><a href="#catalog">Explore the collection ↓</a></section>
<section id="catalog"><div class="toolbar"><div><h2>The collection</h2><p>ETBs & individual packs</p></div><button id="cart-toggle" aria-expanded="false">Your bag (<span id="count">0</span>)</button></div>
<div class="filters" aria-label="Filter products">{['All','Pokémon','Riftbound'].map(c=><button data-filter={c} aria-pressed={c==='All'}>{c}</button>)}</div>
<p class="disclaimer">Preview assortment. Product names, editions, artwork, prices and availability require confirmation before launch.</p>
<div class="grid">{products.map((p,i)=><article data-category={p.category}><div class:list={['art',{'pack':i===2}]} style={`--tone:${p.color}`}><div class="mock"><small>{p.category.toUpperCase()}</small><strong>{p.mark}</strong><span>{p.type}</span></div><span class="art-label">ARTWORK PLACEHOLDER</span></div><div class="info"><small>{p.type}</small><h3>{p.name}</h3><p>Price to be confirmed</p><button data-add={i}>Add to preview bag <span>+</span></button></div></article>)}</div>
<div class="promise"><div><h3>Browse with Crossbell</h3><p>Products and your bag stay on our website.</p></div><div><h3>Checkout with Shopify</h3><p>Secure hosted checkout will be connected before launch.</p></div><div><h3>Delivered to your door</h3><p>Shipping options and handling times coming at launch.</p></div></div></section>
<dialog id="bag"><div class="toolbar"><h2>Your preview bag</h2><button id="close">Close ✕</button></div><div id="items"></div><p id="total">Total pending final pricing</p><button class="checkout" disabled>Shopify checkout · coming soon</button><p class="disclaimer">This preview does not reserve inventory or place an order. No payment information is collected.</p></dialog>
</div>
</Layout>
<style>
.shop{background:#141420;color:#f6f7ff}.notice{text-align:center;background:#2a2a5c;padding:12px;font-size:12px;letter-spacing:1px}.intro,#catalog{max-width:1120px;margin:auto;padding:64px 24px}.intro{background:radial-gradient(ellipse at right,#30305c,transparent 65%);padding-top:85px;padding-bottom:85px}.eyebrow{font-size:12px;letter-spacing:2px;color:#c49350}h1{font-size:clamp(3.5rem,8vw,6rem);line-height:.98;margin:24px 0}em{font-style:normal;color:#c49350}.intro p{max-width:480px;color:#cdd1ff;line-height:1.7}.intro a{display:inline-block;color:#f6f7ff;margin-top:25px;text-decoration:underline;text-underline-offset:8px}.toolbar{display:flex;justify-content:space-between;align-items:center;gap:20px}h2{font-size:2.6rem;margin:0}.toolbar p,.info small{color:#cdd1ff}.filters{display:flex;gap:10px;margin:28px 0 16px}button{cursor:pointer;border:1px solid #57576e;color:inherit;background:transparent;padding:12px 18px;font:inherit;min-height:44px}button:focus-visible,a:focus-visible{outline:3px solid #c49350;outline-offset:4px}.filters button[aria-pressed=true]{background:#c49350;color:#141420;border-color:#c49350}.disclaimer{color:#b7b7ca;font-size:12px;line-height:1.6}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:24px}.art{height:300px;background:radial-gradient(ellipse at center,#35354e,#1b1b30);display:grid;place-items:center;position:relative}.mock{width:75%;height:170px;border:1px solid var(--tone);background:linear-gradient(130deg,#141420,var(--tone));box-shadow:14px 18px 28px #0006;display:flex;flex-direction:column;justify-content:space-between;padding:18px;transform:rotate(-6deg)}.mock strong{font-size:62px;line-height:1}.mock small,.mock span{font-size:10px;letter-spacing:2px}.pack .mock{width:135px;height:220px;transform:rotate(7deg)}.art-label{position:absolute;bottom:12px;font-size:9px;letter-spacing:2px;color:#b7b7ca}.info{padding:24px 0}.info h3{font-size:1.8rem;margin:8px 0}.info p{font-size:14px;color:#cdd1ff}.info button{width:100%;display:flex;justify-content:space-between;background:#c49350;color:#141420;border:0;margin-top:20px}.promise{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;border-top:1px solid #3b3b55;padding:38px 0;margin-top:40px}.promise h3{font-size:1.4rem}.promise p{color:#cdd1ff;font-size:14px;line-height:1.7}dialog{background:#1b1b30;color:#f6f7ff;border:1px solid #64647f;padding:28px;max-width:540px;width:calc(100% - 32px)}dialog::backdrop{background:#000a}.checkout{width:100%;background:#555;color:#ccc;cursor:not-allowed}.row{padding:20px 0;border-bottom:1px solid #555} [hidden]{display:none!important}@media(max-width:700px){.grid,.promise{grid-template-columns:1fr}.intro{padding-top:55px}.toolbar h2{font-size:2rem}.art{height:270px}}
</style>
<script define:vars={{products}}>
const quantities=products.map(()=>0);const dialog=document.querySelector('#bag');
function render(){document.querySelector('#count').textContent=quantities.reduce((a,b)=>a+b,0);const items=document.querySelector('#items');items.replaceChildren();products.forEach((p,i)=>{if(!quantities[i])return;const row=document.createElement('div');row.className='row';const name=document.createElement('p');name.textContent=p.name+' — '+p.type;row.append(name);for(const [label,change] of [['−',-1],['+',1]]){const b=document.createElement('button');b.textContent=label;b.setAttribute('aria-label',(change<0?'Remove one ':'Add one ')+p.name);b.onclick=()=>{quantities[i]=Math.max(0,quantities[i]+change);render()};row.append(b)}const n=document.createElement('span');n.textContent=' Quantity: '+quantities[i];row.append(n);items.append(row)});if(!quantities.some(Boolean))items.textContent='Your bag is empty. Explore the collection to add a preview item.';}
document.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>{quantities[Number(b.dataset.add)]++;render();dialog.showModal();document.querySelector('#cart-toggle').setAttribute('aria-expanded','true')});document.querySelector('#cart-toggle').onclick=()=>{render();dialog.showModal();document.querySelector('#cart-toggle').setAttribute('aria-expanded','true')};document.querySelector('#close').onclick=()=>dialog.close();dialog.onclose=()=>document.querySelector('#cart-toggle').setAttribute('aria-expanded','false');document.querySelectorAll('[data-filter]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-filter]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));document.querySelectorAll('[data-category]').forEach(x=>x.hidden=b.dataset.filter!=='All'&&x.dataset.category!==b.dataset.filter)});render();
</script>

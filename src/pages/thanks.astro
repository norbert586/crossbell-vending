---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import crest from "../assets/brand/crest.png";

// Both Netlify forms redirect here after a successful submission (see the
// `action` attribute in ContactSection.astro). Excluded from the sitemap in
// astro.config.mjs — nobody should land here from a search.
const title = "Thanks | Crossbell Vending";
const description = "We got your message and will follow up shortly.";
---

<Layout title={title} description={description} noindex>
  <section class="py-20 text-center sm:py-28">
    <div class="mx-auto max-w-[1120px] px-5 sm:px-8">
      <Image
        src={crest}
        alt=""
        width={240}
        height={279}
        densities={[1, 2]}
        class="mx-auto mb-6 h-[120px] w-auto"
        loading="eager"
      />
      <p class="font-mono text-sm font-semibold text-accent-dim">SENT</p>
      <h1 class="mt-3 text-[clamp(2rem,4vw,2.75rem)] font-bold">Got it — thanks.</h1>
      <p class="mx-auto mt-3 max-w-[46ch] text-lg text-muted">
        We reply to new requests within one business day. If you reported a problem with a
        machine, we'll have it sorted within 48 hours.
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-3.5">
        <a
          href="/"
          class="inline-flex items-center rounded-[3px] bg-accent px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-accent-hover"
        >
          Back to home
        </a>
        <a
          href={`tel:${site.phoneTel}`}
          class="inline-flex items-center rounded-[3px] border-2 border-ink px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-ink hover:text-paper"
        >
          Call {site.phone}
        </a>
      </div>
    </div>
  </section>
</Layout>

<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Crossbell checkout review</title></head><body><header><strong>CROSSBELL · CHECKOUT REVIEW</strong><nav><button id="desktop" aria-pressed="true">Desktop</button><button id="mobile" aria-pressed="false">Mobile</button><a href="/checkout/">Open checkout ↗</a></nav></header><main><iframe src="/checkout/" title="Checkout preview"></iframe></main></body></html>
<style is:global>body{margin:0;background:#08090b;color:#eee;font:12px system-ui}header{display:flex;justify-content:space-between;align-items:center;padding:18px 25px;border-bottom:1px solid #333}strong{letter-spacing:1px;font-size:10px}nav{display:flex;gap:10px;align-items:center}button,a{font:inherit;color:#ddd;background:none;border:1px solid #444;border-radius:5px;padding:8px 15px;text-decoration:none;cursor:pointer}button[aria-pressed=true]{background:#c8ae79;color:#111;border-color:#c8ae79}main{display:flex;justify-content:center;padding:18px 0}iframe{width:100%;max-width:1440px;height:calc(100vh - 110px);border:1px solid #353535;background:#101214;transition:width .2s}iframe.mobile{width:390px;border-radius:18px}@media(max-width:600px){header{gap:12px;flex-direction:column}iframe{height:calc(100vh - 145px)}}</style>
<script>const frame=document.querySelector('iframe')!;document.querySelectorAll('button').forEach(button=>button.addEventListener('click',()=>{frame.classList.toggle('mobile',button.id==='mobile');document.querySelectorAll('button').forEach(b=>b.setAttribute('aria-pressed',String(b===button)))}));</script>

---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { pack, promotions, location } from "../data/promotions";
import crest from "../assets/brand/crest.png";

// Promotions — the page the resident welcome email links to
// (email/welcome-residents.html). Up top, the Crossbell Pack: tap it, it
// tears open, one card slides out. Below, whatever promotions are running.
// What both say lives in src/data/promotions.ts. /pack/ redirects here
// (netlify.toml) for any link sent before the rename.
//
// Built so the card is the page and the pack is decoration on top of it:
//  - Without JavaScript the card simply shows; the pack never appears.
//  - The inline script under the stage "arms" the pack (hides the card behind
//    it) before first paint, and picks the offer or the after-offer card.
//  - The bundled script runs the opening. Reduced motion gets a short fade.
//
// Not in the nav, not in the sitemap (astro.config.mjs), noindex: it is
// reached from the email, not from search.
const title = "Promotions | Crossbell Vending";
const description = "Open a Crossbell pack and see what's running at your cooler.";

const { card, afterCard } = pack;
const requestHref = `/contact/?loc=${location.slug}#feedback`;

// "Oct 19 – 25", or "Oct 30 – Nov 5" across a month boundary.
const day = (iso: string) => new Date(`${iso}T12:00:00Z`);
const fmt = (d: Date, opts: Intl.DateTimeFormatOptions) =>
  d.toLocaleDateString("en-US", { timeZone: "UTC", ...opts });
const start = day(card.starts);
const end = day(card.ends);
const dates =
  start.getUTCMonth() === end.getUTCMonth()
    ? `${fmt(start, { month: "short", day: "numeric" })} – ${fmt(end, { day: "numeric" })}`
    : `${fmt(start, { month: "short", day: "numeric" })} – ${fmt(end, { month: "short", day: "numeric" })}`;

// The seam between the tear-off strip and the body, and the crimped bottom
// edge, as clip-path polygons. Both pieces of the seam use the same x stops so
// the teeth mesh exactly.
const TEETH = 16;
const TOOTH = 7; // px
const xs = Array.from({ length: TEETH * 2 + 1 }, (_, i) => `${((i / (TEETH * 2)) * 100).toFixed(3)}%`);
const topClip = `polygon(0 0, 100% 0, ${xs
  .slice()
  .reverse()
  .map((x, i) => `${x} ${i % 2 ? `calc(100% - ${TOOTH}px)` : "100%"}`)
  .join(", ")})`;
const bodyClip = `polygon(${xs.map((x, i) => `${x} ${i % 2 ? "0" : `${TOOTH}px`}`).join(", ")}, ${xs
  .slice()
  .reverse()
  .map((x, i) => `${x} ${i % 2 ? `calc(100% - ${TOOTH - 2}px)` : "100%"}`)
  .join(", ")})`;
---

<Layout title={title} description={description} noindex actionBar={false}>
  <section class="promo-stage">
    <div class="relative mx-auto max-w-[1120px] px-5 pb-14 pt-9 text-center sm:px-8 sm:pb-20 sm:pt-14">
      <p class="font-mono text-sm font-semibold uppercase tracking-[0.12em] text-[#e2b775]">Promotions · {location.name}</p>
      <h1 class="mt-2 text-[clamp(2.1rem,4.4vw,3.1rem)] font-bold text-white">A little something extra.</h1>
      <p class="mx-auto mt-2 max-w-[44ch] text-lavender-tint">Open your Crossbell pack, then scroll down for what else is running.</p>

      <div class="pack-scene" data-pack-scene style={`--top-clip:${topClip};--body-clip:${bodyClip};--tooth:${TOOTH}px`}>
        <div class="pack-stage">
          <div class="pack-card" data-pack-card>
            <article class="card" data-card="offer" aria-labelledby="card-offer-title">
              <p class="card-eyebrow">{card.eyebrow}</p>
              <div>
                <h2 id="card-offer-title" class="card-title" tabindex="-1">
                  <span class="card-price">{card.price}</span>
                  <span class="card-product">{card.product}</span>
                </h2>
                <p class="card-detail">{card.detail}</p>
                <p class="card-dates">{dates}</p>
              </div>
              <div class="card-foot">
                <p class="card-fine">{card.fineprint}</p>
                <Image src={crest} alt="" width={64} height={74} densities={[1, 2]} class="card-crest" />
              </div>
            </article>
            <article class="card" data-card="after" aria-labelledby="card-after-title" hidden>
              <p class="card-eyebrow">{afterCard.eyebrow}</p>
              <div>
                <h2 id="card-after-title" class="card-title card-title--words" tabindex="-1">{afterCard.headline}</h2>
                <p class="card-detail">{afterCard.detail}</p>
              </div>
              <Image src={crest} alt="" width={64} height={74} densities={[1, 2]} class="card-crest" />
            </article>
          </div>

          <button type="button" class="pack" data-pack aria-label="Open the Crossbell pack">
            <span class="pack-body" aria-hidden="true">
              <span class="pack-frame"></span>
              <span class="pack-count">1 card</span>
              <Image src={crest} alt="" width={120} height={140} densities={[1, 2]} class="pack-crest" loading="eager" />
              <span class="pack-name">Crossbell</span>
              <span class="pack-rule"></span>
              <span class="pack-kind">Discovery Pack</span>
              <span class="pack-cta">Open to see what's inside.</span>
              <span class="pack-crimp"></span>
            </span>
            <span class="pack-top" aria-hidden="true">
              <span class="pack-tear">Tear to open</span>
            </span>
          </button>
        </div>

        <!-- Arm before first paint: hide the card behind the pack and choose
             which card is in it. Without this script nothing is hidden. -->
        <script is:inline define:vars={{ ends: card.ends }}>
          (function () {
            var scene = document.querySelector("[data-pack-scene]");
            var p = ends.split("-");
            // The offer runs through the whole of its last day, local time.
            if (Date.now() >= new Date(+p[0], +p[1] - 1, +p[2] + 1).getTime()) {
              scene.querySelector('[data-card="offer"]').hidden = true;
              scene.querySelector('[data-card="after"]').hidden = false;
            }
            scene.classList.add("is-armed");
            scene.querySelector("[data-pack-card]").inert = true;
          })();
        </script>

        <p class="pack-hint" data-pack-hint>Tap the pack to open it.</p>

        <div class="pack-actions" data-pack-actions>
          <a
            href={requestHref}
            class="inline-flex items-center rounded-[3px] bg-accent px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-accent-hover"
          >
            Request a product
          </a>
          <button
            type="button"
            data-pack-replay
            class="pack-replay inline-flex items-center rounded-[3px] border-2 border-lavender px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-white hover:text-indigo"
          >
            Open it again
          </button>
        </div>
        {promotions.length > 0 && (
          <a href="#promotions" class="pack-more">
            More promotions <span aria-hidden="true">&darr;</span>
          </a>
        )}
      </div>
    </div>
  </section>

  {promotions.length > 0 && (
    <section id="promotions" class="scroll-mt-20 py-14 sm:py-20">
      <div class="mx-auto max-w-[1120px] px-5 sm:px-8">
        <p class="font-mono text-sm font-semibold uppercase text-accent-dim">Now running</p>
        <h2 class="mt-2 text-[clamp(1.9rem,3.4vw,2.6rem)] font-bold">Promotions at {location.name}</h2>

        <ul class="promo-list mt-8" data-promo-list>
          {promotions.map((promo, i) => (
            <li data-ends={promo.ends}>
              <article class:list={["promo", { "promo--lead": i === 0 }]} aria-labelledby={`promo-${promo.id}`}>
                <Image
                  src={promo.image}
                  alt={promo.alt}
                  widths={[640, 960, 1280, 1536]}
                  sizes={i === 0 ? "(min-width: 1120px) 640px, (min-width: 768px) 58vw, 100vw" : "(min-width: 768px) 50vw, 100vw"}
                  class="promo-image"
                  loading={i === 0 ? "eager" : "lazy"}
                />
                <div class="promo-body">
                  <p class="promo-label">{promo.label}</p>
                  <h3 id={`promo-${promo.id}`} class="mt-3 text-[clamp(1.6rem,2.6vw,2.1rem)] font-bold">{promo.title}</h3>
                  <p class="mt-3 text-[1.02rem] leading-relaxed text-muted">{promo.caption}</p>
                  <a
                    href={promo.action.href ?? requestHref}
                    class="mt-6 inline-flex items-center self-start rounded-[3px] bg-indigo px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-indigo-2"
                  >
                    {promo.action.text} <span aria-hidden="true" class="ml-1.5">&rarr;</span>
                  </a>
                </div>
              </article>
            </li>
          ))}
        </ul>
        <p class="mt-8 text-lg text-muted" data-promo-empty hidden>
          Nothing else running right now. Check back soon, or
          <a href={requestHref} class="font-semibold text-ink underline underline-offset-2">tell us what you'd like to see</a>.
        </p>

        <!-- Hide promotions past their end date (end of that day, local time). -->
        <script is:inline>
          (function () {
            var items = document.querySelectorAll("[data-promo-list] > li[data-ends]");
            var left = document.querySelectorAll("[data-promo-list] > li").length;
            items.forEach(function (li) {
              var p = li.getAttribute("data-ends").split("-");
              if (Date.now() >= new Date(+p[0], +p[1] - 1, +p[2] + 1).getTime()) {
                li.hidden = true;
                left--;
              }
            });
            if (!left) {
              document.querySelector("[data-promo-empty]").hidden = false;
              document.querySelectorAll('a[href="#promotions"]').forEach(function (a) { a.hidden = true; });
            }
          })();
        </script>
      </div>
    </section>
  )}

  <style>
    /* ---------- the stage ----------
       Indigo night with a warm spotlight where the pack sits and a faint foil
       crosshatch that fades out toward the edges. All static. */
    .promo-stage {
      position: relative;
      overflow: hidden;
      isolation: isolate;
      background:
        radial-gradient(55% 42% at 50% 58%, rgb(196 147 80 / 0.28), transparent 70%),
        radial-gradient(130% 90% at 50% 0%, #3b3b75 0%, #2a2a5c 42%, #16162c 100%);
    }
    .promo-stage::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background:
        repeating-linear-gradient(135deg, rgb(255 255 255 / 0.04) 0 1px, transparent 1px 16px),
        repeating-linear-gradient(45deg, rgb(255 255 255 / 0.025) 0 1px, transparent 1px 16px);
      mask-image: radial-gradient(70% 60% at 50% 55%, #000 30%, transparent 80%);
    }
    .promo-stage::after {
      content: "";
      position: absolute;
      inset: auto 0 0;
      height: 3px;
      background: linear-gradient(90deg, transparent, var(--color-accent) 30%, var(--color-accent) 70%, transparent);
    }
    .promo-stage :focus-visible {
      outline-color: var(--color-accent);
    }
    /* A soft pool of light on the "table" under the pack and card */
    .pack-stage::after {
      content: "";
      position: absolute;
      left: 8%;
      right: 8%;
      bottom: -9%;
      height: 12%;
      z-index: 0;
      border-radius: 50%;
      background: radial-gradient(closest-side, rgb(0 0 0 / 0.45), transparent);
      pointer-events: none;
    }

    /* Card and pack share one footprint, 5:7. Sized so the pack, the hint and
       the buttons fit on a phone screen under the sticky header. */
    .pack-scene {
      --w: clamp(220px, min(300px, 74vw, calc((100svh - 360px) * 5 / 7)), 300px);
      margin-top: calc(var(--w) * 0.26);
    }
    .pack-stage {
      position: relative;
      width: var(--w);
      aspect-ratio: 5 / 7;
      margin-inline: auto;
    }

    /* ---------- the card ---------- */
    /* The container is the wrapper, not the card: a card's own padding in cqw
       would otherwise resolve against the nearest container above it — none,
       so the viewport — and blow up on a wide screen. */
    .pack-card {
      position: absolute;
      inset: 0;
      z-index: 3;
      container-type: inline-size;
    }
    .card {
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      height: 100%;
      padding: 9cqw 8cqw 7cqw;
      background: #fff;
      border: 1px solid var(--color-line);
      outline: 2px solid var(--color-accent);
      outline-offset: -3.5cqw;
      box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.6);
      color: var(--color-ink);
      text-align: center;
      transition: box-shadow 500ms ease;
    }
    /* One pass of light across the card as it lands (run from the script). */
    .card::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(105deg, transparent 35%, rgb(255 255 255 / 0.75) 50%, transparent 65%);
      transform: translateX(-130%);
      pointer-events: none;
    }
    .is-open .card {
      box-shadow:
        0 24px 60px -20px rgb(0 0 0 / 0.65),
        0 0 70px -10px rgb(226 183 117 / 0.45);
    }
    .card[hidden] {
      display: none;
    }
    .card-eyebrow {
      font-family: var(--font-mono);
      font-size: max(11px, 3.8cqw);
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-accent-dim);
    }
    .card-title {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-top: 3cqw;
      outline: none;
    }
    .card-price {
      font-size: 40cqw;
      font-weight: 700;
      line-height: 0.9;
      color: var(--color-indigo);
    }
    .card-product {
      font-size: 13cqw;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      line-height: 1;
    }
    .card-title--words {
      font-size: 14cqw;
      font-weight: 700;
      line-height: 1.02;
    }
    .card-detail {
      margin-top: 4cqw;
      font-size: max(15px, 5.2cqw);
      line-height: 1.4;
      text-wrap: balance;
    }
    .card-dates {
      margin-top: 3cqw;
      font-family: var(--font-mono);
      font-size: max(13px, 4.6cqw);
      font-weight: 700;
      color: var(--color-indigo);
    }
    .card-fine {
      font-size: max(12px, 3.8cqw);
      line-height: 1.4;
      color: var(--color-muted);
      text-wrap: balance;
    }
    .card-crest {
      width: 9cqw;
      height: auto;
    }
    .card-foot {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3cqw;
    }

    /* ---------- the pack ---------- */
    .pack {
      display: none;
      position: absolute;
      inset: 0;
      z-index: 2;
      width: 100%;
      cursor: pointer;
      container-type: inline-size;
      /* A gold hairline and a warm halo lift indigo foil off the indigo stage. */
      filter:
        drop-shadow(0 0 1px rgb(226 183 117 / 0.7))
        drop-shadow(0 0 36px rgb(196 147 80 / 0.28))
        drop-shadow(0 22px 24px rgb(0 0 0 / 0.45));
      border-radius: 4px;
    }
    .pack-body,
    .pack-top {
      position: absolute;
      left: 0;
      right: 0;
      /* Foil: indigo with one soft highlight band. Hover slides the band a
         little; that is the only idle motion on the page. */
      background:
        repeating-linear-gradient(90deg, rgb(255 255 255 / 0.025) 0 1px, transparent 1px 5px),
        linear-gradient(115deg, #23234f 0%, #2f2f66 34%, #4b4b8c 46%, #33336c 58%, #202048 100%);
      background-size: auto, 220% 100%;
      background-position: 0 0, 30% 0;
      transition: background-position 600ms ease;
    }
    .pack:hover .pack-body,
    .pack:hover .pack-top,
    .pack:focus-visible .pack-body,
    .pack:focus-visible .pack-top {
      background-position: 0 0, 55% 0;
    }
    .pack-top {
      top: 0;
      height: 17%;
      clip-path: var(--top-clip);
      transform-origin: 0% 100%;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      padding-bottom: calc(var(--tooth) + 2.2cqw);
    }
    /* Heat-seal ridges across the strip */
    .pack-top::before {
      content: "";
      position: absolute;
      inset: 0 0 auto;
      height: 55%;
      background: repeating-linear-gradient(0deg, rgb(0 0 0 / 0.18) 0 1px, transparent 1px 4px);
    }
    .pack-tear {
      position: relative;
      font-family: var(--font-mono);
      font-size: max(9px, 3.2cqw);
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-lavender);
      opacity: 0.85;
    }
    .pack-body {
      top: calc(17% - var(--tooth));
      bottom: 0;
      clip-path: var(--body-clip);
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-top: 15cqw;
      color: #fff;
    }
    .pack-frame {
      position: absolute;
      inset: 6cqw 6cqw 10cqw;
      border: 1px solid rgb(196 147 80 / 0.6);
    }
    .pack-count {
      position: absolute;
      top: 9cqw;
      left: 10cqw;
      font-family: var(--font-mono);
      font-size: max(9px, 3.2cqw);
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-lavender);
    }
    .pack-crest {
      width: 30cqw;
      height: auto;
      filter: drop-shadow(0 4px 10px rgb(0 0 0 / 0.35));
    }
    .pack-name {
      margin-top: 6cqw;
      font-family: var(--font-display);
      font-size: 15cqw;
      font-weight: 700;
      line-height: 1;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      /* optical centering: tracking adds space after the last letter */
      padding-left: 0.12em;
    }
    .pack-rule {
      width: 26cqw;
      height: 2px;
      margin-top: 4cqw;
      background: var(--color-accent);
    }
    .pack-kind {
      margin-top: 4cqw;
      font-family: var(--font-mono);
      font-size: max(11px, 4.4cqw);
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: #e2b775;
      padding-left: 0.22em;
    }
    .pack-cta {
      margin-top: auto;
      margin-bottom: 15cqw;
      font-size: max(12px, 4.4cqw);
      color: var(--color-lavender-tint);
    }
    .pack-crimp {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 7cqw;
      background: repeating-linear-gradient(0deg, rgb(0 0 0 / 0.2) 0 1px, transparent 1px 4px);
    }

    /* ---------- states ----------
       default (no JS): card shows, no pack, no replay.
       armed: pack shows, card tucked inside it, buttons wait.
       open: pack gone, card and buttons show. */
    .pack-hint,
    .pack-replay {
      display: none;
    }
    .pack-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.75rem;
      margin-top: 1.75rem;
    }
    .is-armed .pack {
      display: block;
    }
    .is-armed .pack-replay {
      display: inline-flex;
    }
    .is-armed:not(.is-open) .pack-card {
      z-index: 1;
      transform: translateY(4%) scale(0.88);
    }
    .is-armed:not(.is-open):not(.is-opening) .pack-hint {
      display: block;
      margin-top: 1.5rem;
      font-size: 1rem;
      color: var(--color-lavender-tint);
    }
    .pack-more {
      display: inline-block;
      margin-top: 1.5rem;
      font-family: var(--font-mono);
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #e2b775;
    }
    .pack-more:hover {
      color: #fff;
    }
    .is-armed:not(.is-open) .pack-more {
      visibility: hidden;
    }

    /* ---------- promotions list ---------- */
    .promo-list {
      display: grid;
      gap: 1.25rem;
    }
    @media (min-width: 768px) {
      .promo-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .promo-list > li:first-child {
        grid-column: 1 / -1;
      }
    }
    .promo {
      display: flex;
      flex-direction: column;
      height: 100%;
      overflow: hidden;
      border: 1px solid var(--color-line);
      border-top: 3px solid var(--color-accent);
      background: #fff;
    }
    .promo-image {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 3 / 2;
      object-fit: cover;
      background: var(--color-ink);
    }
    .promo-body {
      display: flex;
      flex-direction: column;
      padding: 1.5rem 1.5rem 1.75rem;
    }
    @media (min-width: 768px) {
      .promo--lead {
        display: grid;
        grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
      }
      .promo--lead .promo-image {
        height: 100%;
      }
      .promo--lead .promo-body {
        justify-content: center;
        padding: 2rem 2.25rem;
      }
    }
    .promo-label {
      align-self: flex-start;
      padding: 0.3rem 0.6rem;
      background: var(--color-lavender-tint);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-indigo);
    }
    .is-armed:not(.is-open) .pack-actions {
      visibility: hidden;
    }
    .is-open .pack {
      display: none;
    }
  </style>

  <script>
    // The opening, about 1.4 s end to end: a press, the strip tears off, the
    // card rises out of the pack, then the pack drops away and the card comes
    // forward. Plain Web Animations — nothing to load. Every step uses
    // fill: "both" so a replay can cancel the lot and start clean.
    const scene = document.querySelector<HTMLElement>("[data-pack-scene]");
    const pack = scene?.querySelector<HTMLButtonElement>("[data-pack]");
    const top = scene?.querySelector<HTMLElement>(".pack-top");
    const body = scene?.querySelector<HTMLElement>(".pack-body");
    const cardWrap = scene?.querySelector<HTMLElement>("[data-pack-card]");
    const actions = scene?.querySelector<HTMLElement>("[data-pack-actions]");
    const replay = scene?.querySelector<HTMLButtonElement>("[data-pack-replay]");

    if (scene && pack && top && body && cardWrap && actions && replay) {
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const ease = "cubic-bezier(0.2, 0, 0, 1)";
      const tucked = "translateY(4%) scale(0.88)";
      const risen = "translateY(-22%) scale(0.88)";
      let opening = false;

      const run = (el: Element, keyframes: Keyframe[], options: KeyframeAnimationOptions) =>
        el.animate(keyframes, { fill: "both", easing: ease, ...options }).finished;

      const finish = () => {
        scene.classList.replace("is-opening", "is-open");
        cardWrap.inert = false;
        cardWrap.querySelector<HTMLElement>(".card:not([hidden]) .card-title")?.focus({ preventScroll: true });
        if (!reduced) {
          run(actions, [{ opacity: 0, transform: "translateY(6px)" }, { opacity: 1, transform: "none" }], { duration: 300 });
          const face = cardWrap.querySelector(".card:not([hidden])");
          face?.animate([{ transform: "translateX(-130%)" }, { transform: "translateX(130%)" }], {
            duration: 900,
            delay: 80,
            easing: "ease-in-out",
            pseudoElement: "::after",
          });
        }
        opening = false;
      };

      const open = async () => {
        if (opening || scene.classList.contains("is-open")) return;
        opening = true;
        scene.classList.add("is-opening");
        try {
          if (reduced) {
            cardWrap.style.zIndex = "3";
            await Promise.all([
              run(pack, [{ opacity: 1 }, { opacity: 0 }], { duration: 200 }),
              run(cardWrap, [{ opacity: 0, transform: "none" }, { opacity: 1, transform: "none" }], { duration: 200 }),
            ]);
          } else {
            await run(pack, [{ transform: "scale(1)" }, { transform: "scale(0.97)", offset: 0.4 }, { transform: "scale(1)" }], { duration: 220, easing: "ease-out" });
            const tear = run(top, [
              { transform: "none", opacity: 1 },
              { transform: "rotate(-9deg)", opacity: 1, offset: 0.35 },
              { transform: "translate(34%, -120%) rotate(-24deg)", opacity: 0 },
            ], { duration: 560, easing: "cubic-bezier(0.4, 0, 0.6, 1)" });
            await new Promise((r) => setTimeout(r, 240));
            await run(cardWrap, [{ transform: tucked }, { transform: risen }], { duration: 480 });
            cardWrap.style.zIndex = "3";
            await Promise.all([
              tear,
              run(body, [{ transform: "none", opacity: 1 }, { transform: "translateY(16%)", opacity: 0 }], { duration: 380, easing: "ease-in" }),
              run(cardWrap, [{ transform: risen }, { transform: "none" }], { duration: 460 }),
            ]);
          }
        } catch {
          // An interrupted animation must not strand anyone at a closed pack.
        }
        finish();
      };

      const reset = () => {
        [pack, top, body, cardWrap, actions].forEach((el) => el.getAnimations().forEach((a) => a.cancel()));
        cardWrap.style.zIndex = "";
        cardWrap.inert = true;
        scene.classList.remove("is-open");
        pack.focus();
      };

      pack.addEventListener("click", open);
      replay.addEventListener("click", reset);
    }
  </script>
</Layout>

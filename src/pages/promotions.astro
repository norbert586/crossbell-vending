---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { pack, promotions, location } from "../data/promotions";
import crest from "../assets/brand/crest.png";

// Promotions — the page the resident welcome email links to
// (email/welcome-residents.html). Up top, the Crossbell Pack: tap it, it
// tears open, one card slides out. Below, whatever promotions are running.
// What both say lives in src/data/promotions.ts. /pack/ redirects here
// (netlify.toml) for any link sent before the rename.
//
// Built so the card is the page and the pack is decoration on top of it:
//  - Without JavaScript the card simply shows; the pack never appears.
//  - The inline script under the stage "arms" the pack (hides the card behind
//    it) before first paint, and picks the offer or the after-offer card.
//  - The bundled script runs the opening. Reduced motion gets a short fade.
//
// Not in the nav, not in the sitemap (astro.config.mjs), noindex: it is
// reached from the email, not from search.
const title = "Promotions | Crossbell Vending";
const description = "Open a Crossbell pack and see what's running at your cooler.";

const { card, afterCard } = pack;
const requestHref = `/contact/?loc=${location.slug}#feedback`;

// "Oct 19 – 25", or "Oct 30 – Nov 5" across a month boundary.
const day = (iso: string) => new Date(`${iso}T12:00:00Z`);
const fmt = (d: Date, opts: Intl.DateTimeFormatOptions) =>
  d.toLocaleDateString("en-US", { timeZone: "UTC", ...opts });
const start = day(card.starts);
const end = day(card.ends);
const dates =
  start.getUTCMonth() === end.getUTCMonth()
    ? `${fmt(start, { month: "short", day: "numeric" })} – ${fmt(end, { day: "numeric" })}`
    : `${fmt(start, { month: "short", day: "numeric" })} – ${fmt(end, { month: "short", day: "numeric" })}`;

// The seam between the tear-off strip and the body, and the crimped bottom
// edge, as clip-path polygons. Both pieces of the seam use the same x stops so
// the teeth mesh exactly.
const TEETH = 16;
const TOOTH = 7; // px
const xs = Array.from({ length: TEETH * 2 + 1 }, (_, i) => `${((i / (TEETH * 2)) * 100).toFixed(3)}%`);
const topClip = `polygon(0 0, 100% 0, ${xs
  .slice()
  .reverse()
  .map((x, i) => `${x} ${i % 2 ? `calc(100% - ${TOOTH}px)` : "100%"}`)
  .join(", ")})`;
const bodyClip = `polygon(${xs.map((x, i) => `${x} ${i % 2 ? "0" : `${TOOTH}px`}`).join(", ")}, ${xs
  .slice()
  .reverse()
  .map((x, i) => `${x} ${i % 2 ? `calc(100% - ${TOOTH - 2}px)` : "100%"}`)
  .join(", ")})`;
---

<Layout title={title} description={description} noindex actionBar={false}>
  <section class="promo-stage">
    <div class="relative mx-auto max-w-[1120px] px-5 pb-14 pt-9 text-center sm:px-8 sm:pb-20 sm:pt-14">
      <p class="font-mono text-sm font-semibold uppercase tracking-[0.12em] text-[#e2b775]">Promotions · {location.name}</p>
      <h1 class="mt-2 text-[clamp(2.1rem,4.4vw,3.1rem)] font-bold text-white">A little something extra.</h1>
      <p class="mx-auto mt-2 max-w-[44ch] text-lavender-tint">Open your Crossbell pack, then scroll down for what else is running.</p>

      <div class="pack-scene" data-pack-scene style={`--top-clip:${topClip};--body-clip:${bodyClip};--tooth:${TOOTH}px`}>
        <div class="pack-stage">
          <div class="pack-card" data-pack-card>
            <article class="card" data-card="offer" aria-labelledby="card-offer-title">
              <p class="card-eyebrow">{card.eyebrow}</p>
              <div>
                <h2 id="card-offer-title" class="card-title" tabindex="-1">
                  <span class="card-price">{card.price}</span>
                  <span class="card-product">{card.product}</span>
                </h2>
                <p class="card-detail">{card.detail}</p>
                <p class="card-dates">{dates}</p>
              </div>
              <div class="card-foot">
                <p class="card-fine">{card.fineprint}</p>
                <Image src={crest} alt="" width={64} height={74} densities={[1, 2]} class="card-crest" />
              </div>
            </article>
            <article class="card" data-card="after" aria-labelledby="card-after-title" hidden>
              <p class="card-eyebrow">{afterCard.eyebrow}</p>
              <div>
                <h2 id="card-after-title" class="card-title card-title--words" tabindex="-1">{afterCard.headline}</h2>
                <p class="card-detail">{afterCard.detail}</p>
              </div>
              <Image src={crest} alt="" width={64} height={74} densities={[1, 2]} class="card-crest" />
            </article>
          </div>

          <!-- The tear strip is drawn twice: the piece that rips away and the
               piece still attached to the pack. Each is clipped to its side of
               the tear point (--p, 0..1) so together they always look like
               one strip torn exactly as far as the finger has gone. -->
          <button type="button" class="pack" data-pack aria-label="Open the Crossbell pack">
            <span class="pack-inner" data-pack-inner>
              <span class="pack-body" aria-hidden="true">
                <span class="pack-frame"></span>
                <span class="pack-count">1 card</span>
                <Image src={crest} alt="" width={120} height={140} densities={[1, 2]} class="pack-crest" loading="eager" />
                <span class="pack-name">Crossbell</span>
                <span class="pack-rule"></span>
                <span class="pack-kind">Discovery Pack</span>
                <span class="pack-cta">Open to see what's inside.</span>
                <span class="pack-crimp"></span>
                <span class="pack-shine"></span>
              </span>
              <span class="tear tear--on" aria-hidden="true">
                <span class="pack-top"><span class="pack-tear">Tear to open</span><span class="pack-shine"></span></span>
              </span>
              <span class="tear tear--off" data-tear-off aria-hidden="true">
                <span class="pack-top"><span class="pack-tear">Tear to open</span><span class="pack-shine"></span></span>
              </span>
              <span class="tear-front" aria-hidden="true"></span>
            </span>
          </button>
        </div>

        <!-- Arm before first paint: hide the card behind the pack and choose
             which card is in it. Without this script nothing is hidden. -->
        <script is:inline define:vars={{ ends: card.ends }}>
          (function () {
            var scene = document.querySelector("[data-pack-scene]");
            var p = ends.split("-");
            // The offer runs through the whole of its last day, local time.
            if (Date.now() >= new Date(+p[0], +p[1] - 1, +p[2] + 1).getTime()) {
              scene.querySelector('[data-card="offer"]').hidden = true;
              scene.querySelector('[data-card="after"]').hidden = false;
            }
            scene.classList.add("is-armed");
            scene.querySelector("[data-pack-card]").inert = true;
          })();
        </script>

        <p class="pack-hint" data-pack-hint aria-live="polite">Swipe across the top to tear it open, or just tap.</p>

        <div class="pack-actions" data-pack-actions>
          <a
            href={requestHref}
            class="inline-flex items-center rounded-[3px] bg-accent px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-accent-hover"
          >
            Request a product
          </a>
          <button
            type="button"
            data-pack-replay
            class="pack-replay inline-flex items-center rounded-[3px] border-2 border-lavender px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-white hover:text-indigo"
          >
            Open it again
          </button>
        </div>
        {promotions.length > 0 && (
          <a href="#promotions" class="pack-more">
            More promotions <span aria-hidden="true">&darr;</span>
          </a>
        )}
      </div>
    </div>
  </section>

  {promotions.length > 0 && (
    <section id="promotions" class="scroll-mt-20 py-14 sm:py-20">
      <div class="mx-auto max-w-[1120px] px-5 sm:px-8">
        <p class="font-mono text-sm font-semibold uppercase text-accent-dim">Now running</p>
        <h2 class="mt-2 text-[clamp(1.9rem,3.4vw,2.6rem)] font-bold">Promotions at {location.name}</h2>

        <ul class="promo-list mt-8" data-promo-list>
          {promotions.map((promo, i) => (
            <li data-ends={promo.ends}>
              <article class:list={["promo", { "promo--lead": i === 0 }]} aria-labelledby={`promo-${promo.id}`}>
                <Image
                  src={promo.image}
                  alt={promo.alt}
                  widths={[640, 960, 1280, 1536]}
                  sizes={i === 0 ? "(min-width: 1120px) 640px, (min-width: 768px) 58vw, 100vw" : "(min-width: 768px) 50vw, 100vw"}
                  class="promo-image"
                  loading={i === 0 ? "eager" : "lazy"}
                />
                <div class="promo-body">
                  <p class="promo-label">{promo.label}</p>
                  <h3 id={`promo-${promo.id}`} class="mt-3 text-[clamp(1.6rem,2.6vw,2.1rem)] font-bold">{promo.title}</h3>
                  <p class="mt-3 text-[1.02rem] leading-relaxed text-muted">{promo.caption}</p>
                  <a
                    href={promo.action.href ?? requestHref}
                    class="mt-6 inline-flex items-center self-start rounded-[3px] bg-indigo px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-indigo-2"
                  >
                    {promo.action.text} <span aria-hidden="true" class="ml-1.5">&rarr;</span>
                  </a>
                </div>
              </article>
            </li>
          ))}
        </ul>
        <p class="mt-8 text-lg text-muted" data-promo-empty hidden>
          Nothing else running right now. Check back soon, or
          <a href={requestHref} class="font-semibold text-ink underline underline-offset-2">tell us what you'd like to see</a>.
        </p>

        <!-- Hide promotions past their end date (end of that day, local time). -->
        <script is:inline>
          (function () {
            var items = document.querySelectorAll("[data-promo-list] > li[data-ends]");
            var left = document.querySelectorAll("[data-promo-list] > li").length;
            items.forEach(function (li) {
              var p = li.getAttribute("data-ends").split("-");
              if (Date.now() >= new Date(+p[0], +p[1] - 1, +p[2] + 1).getTime()) {
                li.hidden = true;
                left--;
              }
            });
            if (!left) {
              document.querySelector("[data-promo-empty]").hidden = false;
              document.querySelectorAll('a[href="#promotions"]').forEach(function (a) { a.hidden = true; });
            }
          })();
        </script>
      </div>
    </section>
  )}

  <style>
    /* ---------- the stage ----------
       Indigo night with a warm spotlight where the pack sits and a faint foil
       crosshatch that fades out toward the edges. All static. */
    .promo-stage {
      position: relative;
      overflow: hidden;
      isolation: isolate;
      background:
        radial-gradient(55% 42% at 50% 58%, rgb(196 147 80 / 0.28), transparent 70%),
        radial-gradient(130% 90% at 50% 0%, #3b3b75 0%, #2a2a5c 42%, #16162c 100%);
    }
    .promo-stage::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background:
        repeating-linear-gradient(135deg, rgb(255 255 255 / 0.04) 0 1px, transparent 1px 16px),
        repeating-linear-gradient(45deg, rgb(255 255 255 / 0.025) 0 1px, transparent 1px 16px);
      mask-image: radial-gradient(70% 60% at 50% 55%, #000 30%, transparent 80%);
    }
    .promo-stage::after {
      content: "";
      position: absolute;
      inset: auto 0 0;
      height: 3px;
      background: linear-gradient(90deg, transparent, var(--color-accent) 30%, var(--color-accent) 70%, transparent);
    }
    .promo-stage :focus-visible {
      outline-color: var(--color-accent);
    }
    /* A soft pool of light on the "table" under the pack and card */
    .pack-stage::after {
      content: "";
      position: absolute;
      left: 8%;
      right: 8%;
      bottom: -9%;
      height: 12%;
      z-index: 0;
      border-radius: 50%;
      background: radial-gradient(closest-side, rgb(0 0 0 / 0.45), transparent);
      pointer-events: none;
    }

    /* Card and pack share one footprint, 5:7. Sized so the pack, the hint and
       the buttons fit on a phone screen under the sticky header. */
    .pack-scene {
      --w: clamp(220px, min(300px, 74vw, calc((100svh - 360px) * 5 / 7)), 300px);
      margin-top: calc(var(--w) * 0.26);
    }
    .pack-stage {
      position: relative;
      width: var(--w);
      aspect-ratio: 5 / 7;
      margin-inline: auto;
    }

    /* ---------- the card ---------- */
    /* The container is the wrapper, not the card: a card's own padding in cqw
       would otherwise resolve against the nearest container above it — none,
       so the viewport — and blow up on a wide screen. */
    .pack-card {
      position: absolute;
      inset: 0;
      z-index: 3;
      container-type: inline-size;
    }
    .card {
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      height: 100%;
      padding: 9cqw 8cqw 7cqw;
      background: #fff;
      border: 1px solid var(--color-line);
      outline: 2px solid var(--color-accent);
      outline-offset: -3.5cqw;
      box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.6);
      color: var(--color-ink);
      text-align: center;
      transition: box-shadow 500ms ease;
    }
    .pack-card {
      perspective: 900px;
    }
    .is-open .card {
      transform: rotateX(calc(var(--cy, 0) * -8deg)) rotateY(calc(var(--cx, 0) * 10deg));
      transition: transform 180ms ease-out, box-shadow 500ms ease;
    }
    /* Holo glare that follows the finger once the card is out */
    .card::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background:
        radial-gradient(circle at calc(50% + var(--cx, 0) * 60%) calc(50% + var(--cy, 0) * 60%), rgb(255 255 255 / 0.55), transparent 45%),
        linear-gradient(calc(115deg + var(--cx, 0) * 30deg), transparent 35%, rgb(205 209 255 / 0.35) 47%, rgb(246 220 170 / 0.35) 53%, transparent 65%);
      mix-blend-mode: soft-light;
      opacity: 0;
      transition: opacity 300ms ease;
    }
    .is-open .card.is-lit::before {
      opacity: 1;
    }
    /* One pass of light across the card as it lands (run from the script). */
    .card::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(105deg, transparent 35%, rgb(255 255 255 / 0.75) 50%, transparent 65%);
      transform: translateX(-130%);
      pointer-events: none;
    }
    .is-open .card {
      box-shadow:
        0 24px 60px -20px rgb(0 0 0 / 0.65),
        0 0 70px -10px rgb(226 183 117 / 0.45);
    }
    .card[hidden] {
      display: none;
    }
    .card-eyebrow {
      font-family: var(--font-mono);
      font-size: max(11px, 3.8cqw);
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-accent-dim);
    }
    .card-title {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-top: 3cqw;
      outline: none;
    }
    .card-price {
      font-size: 40cqw;
      font-weight: 700;
      line-height: 0.9;
      color: var(--color-indigo);
    }
    .card-product {
      font-size: 13cqw;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      line-height: 1;
    }
    .card-title--words {
      font-size: 14cqw;
      font-weight: 700;
      line-height: 1.02;
    }
    .card-detail {
      margin-top: 4cqw;
      font-size: max(15px, 5.2cqw);
      line-height: 1.4;
      text-wrap: balance;
    }
    .card-dates {
      margin-top: 3cqw;
      font-family: var(--font-mono);
      font-size: max(13px, 4.6cqw);
      font-weight: 700;
      color: var(--color-indigo);
    }
    .card-fine {
      font-size: max(12px, 3.8cqw);
      line-height: 1.4;
      color: var(--color-muted);
      text-wrap: balance;
    }
    .card-crest {
      width: 9cqw;
      height: auto;
    }
    .card-foot {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3cqw;
    }

    /* ---------- the pack ---------- */
    .pack {
      display: none;
      position: absolute;
      inset: 0;
      z-index: 2;
      width: 100%;
      cursor: pointer;
      container-type: inline-size;
      /* A gold hairline and a warm halo lift indigo foil off the indigo stage. */
      filter:
        drop-shadow(0 0 1px rgb(226 183 117 / 0.7))
        drop-shadow(0 0 36px rgb(196 147 80 / 0.28))
        drop-shadow(0 22px 24px rgb(0 0 0 / 0.45));
      border-radius: 4px;
      perspective: 900px;
      /* Horizontal drags are ours (the tear); vertical ones still scroll. */
      touch-action: pan-y;
      user-select: none;
      -webkit-user-select: none;
      -webkit-tap-highlight-color: transparent;
    }
    /* Follows the finger or cursor: a few degrees of tilt, no more. */
    .pack-inner {
      position: absolute;
      inset: 0;
      transform: rotateX(calc(var(--my, 0) * -7deg)) rotateY(calc(var(--mx, 0) * 9deg));
      transition: transform 160ms ease-out;
    }
    .pack-body,
    .pack-top {
      position: absolute;
      left: 0;
      right: 0;
      /* Foil: indigo with one soft highlight band. Hover slides the band a
         little; that is the only idle motion on the page. */
      background:
        repeating-linear-gradient(90deg, rgb(255 255 255 / 0.025) 0 1px, transparent 1px 5px),
        linear-gradient(115deg, #23234f 0%, #2f2f66 34%, #4b4b8c 46%, #33336c 58%, #202048 100%);
      background-size: auto, 220% 100%;
      /* The highlight band slides with the pointer, like foil under a lamp. */
      background-position: 0 0, calc(32% + var(--mx, 0) * 30%) 0;
    }
    .pack-top {
      top: 0;
      height: 100%;
      clip-path: var(--top-clip);
      transform-origin: 0% 100%;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      padding-bottom: calc(var(--tooth) + 2.2cqw);
    }
    /* Heat-seal ridges across the strip */
    .pack-top::before {
      content: "";
      position: absolute;
      inset: 0 0 auto;
      height: 55%;
      background: repeating-linear-gradient(0deg, rgb(0 0 0 / 0.18) 0 1px, transparent 1px 4px);
    }
    .pack-tear {
      position: relative;
      font-family: var(--font-mono);
      font-size: max(9px, 3.2cqw);
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-lavender);
      opacity: 0.85;
    }
    /* ---------- the tear ---------- */
    .tear {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 17%;
    }
    .tear--on {
      clip-path: inset(-5% 0 -5% calc(var(--p, 0) * 100%));
    }
    .tear--off {
      clip-path: inset(-60% calc((1 - var(--p, 0)) * 100%) -5% -10%);
      transform-origin: calc(var(--p, 0) * 100%) 100%;
      transform: translateY(calc(var(--p, 0) * -14%)) rotate(calc(var(--p, 0) * -12deg));
      filter: brightness(1.18);
    }
    .is-rtl .tear--on {
      clip-path: inset(-5% calc(var(--p, 0) * 100%) -5% 0);
    }
    .is-rtl .tear--off {
      clip-path: inset(-60% -10% -5% calc((1 - var(--p, 0)) * 100%));
      transform-origin: calc((1 - var(--p, 0)) * 100%) 100%;
      transform: translateY(calc(var(--p, 0) * -14%)) rotate(calc(var(--p, 0) * 12deg));
    }
    /* The bright, ragged edge where foil is parting */
    .tear-front {
      position: absolute;
      top: 0;
      height: 17%;
      left: calc(var(--p, 0) * 100%);
      width: 5px;
      margin-left: -2.5px;
      opacity: 0;
      background: linear-gradient(180deg, transparent, #fff 25%, #f6dcaa 70%, transparent);
      clip-path: polygon(50% 0, 100% 12%, 20% 26%, 100% 40%, 10% 55%, 90% 70%, 0 84%, 60% 100%, 0 100%, 0 0);
      filter: drop-shadow(0 0 6px rgb(226 183 117 / 0.95));
      pointer-events: none;
    }
    .is-rtl .tear-front {
      left: calc((1 - var(--p, 0)) * 100%);
    }
    .is-tearing .tear-front {
      opacity: 1;
    }
    /* Light catching the foil where the pointer is */
    .pack-shine {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        radial-gradient(circle at calc(50% + var(--mx, 0) * 55%) calc(45% + var(--my, 0) * 55%), rgb(255 255 255 / 0.32), transparent 42%),
        linear-gradient(calc(110deg + var(--mx, 0) * 25deg), transparent 30%, rgb(205 209 255 / 0.18) 45%, rgb(226 183 117 / 0.16) 55%, transparent 70%);
      mix-blend-mode: overlay;
      opacity: var(--shine, 0.55);
      transition: opacity 300ms ease;
    }

    .pack-body {
      top: calc(17% - var(--tooth));
      bottom: 0;
      clip-path: var(--body-clip);
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-top: 15cqw;
      color: #fff;
    }
    .pack-frame {
      position: absolute;
      inset: 6cqw 6cqw 10cqw;
      border: 1px solid rgb(196 147 80 / 0.6);
    }
    .pack-count {
      position: absolute;
      top: 9cqw;
      left: 10cqw;
      font-family: var(--font-mono);
      font-size: max(9px, 3.2cqw);
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-lavender);
    }
    .pack-crest {
      width: 30cqw;
      height: auto;
      filter: drop-shadow(0 4px 10px rgb(0 0 0 / 0.35));
    }
    .pack-name {
      margin-top: 6cqw;
      font-family: var(--font-display);
      font-size: 15cqw;
      font-weight: 700;
      line-height: 1;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      /* optical centering: tracking adds space after the last letter */
      padding-left: 0.12em;
    }
    .pack-rule {
      width: 26cqw;
      height: 2px;
      margin-top: 4cqw;
      background: var(--color-accent);
    }
    .pack-kind {
      margin-top: 4cqw;
      font-family: var(--font-mono);
      font-size: max(11px, 4.4cqw);
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: #e2b775;
      padding-left: 0.22em;
    }
    .pack-cta {
      margin-top: auto;
      margin-bottom: 15cqw;
      font-size: max(12px, 4.4cqw);
      color: var(--color-lavender-tint);
    }
    .pack-crimp {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 7cqw;
      background: repeating-linear-gradient(0deg, rgb(0 0 0 / 0.2) 0 1px, transparent 1px 4px);
    }

    /* ---------- states ----------
       default (no JS): card shows, no pack, no replay.
       armed: pack shows, card tucked inside it, buttons wait.
       open: pack gone, card and buttons show. */
    .pack-hint,
    .pack-replay {
      display: none;
    }
    .pack-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.75rem;
      margin-top: 1.75rem;
    }
    .is-armed .pack {
      display: block;
    }
    .is-torn .pack {
      touch-action: none;
      cursor: grab;
    }
    .is-torn .tear--off,
    .is-torn .tear-front {
      visibility: hidden;
    }
    .is-armed .pack-replay {
      display: inline-flex;
    }
    .is-armed:not(.is-open) .pack-card {
      z-index: 1;
      transform: translateY(4%) scale(0.88);
    }
    .is-armed:not(.is-open):not(.is-opening) .pack-hint {
      display: block;
      margin-top: 1.5rem;
      font-size: 1rem;
      color: var(--color-lavender-tint);
    }
    .pack-more {
      display: inline-block;
      margin-top: 1.5rem;
      font-family: var(--font-mono);
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #e2b775;
    }
    .pack-more:hover {
      color: #fff;
    }
    .is-armed:not(.is-open) .pack-more {
      visibility: hidden;
    }

    /* ---------- promotions list ---------- */
    .promo-list {
      display: grid;
      gap: 1.25rem;
    }
    @media (min-width: 768px) {
      .promo-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .promo-list > li:first-child {
        grid-column: 1 / -1;
      }
    }
    .promo {
      display: flex;
      flex-direction: column;
      height: 100%;
      overflow: hidden;
      border: 1px solid var(--color-line);
      border-top: 3px solid var(--color-accent);
      background: #fff;
    }
    .promo-image {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 3 / 2;
      object-fit: cover;
      background: var(--color-ink);
    }
    .promo-body {
      display: flex;
      flex-direction: column;
      padding: 1.5rem 1.5rem 1.75rem;
    }
    @media (min-width: 768px) {
      .promo--lead {
        display: grid;
        grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
      }
      .promo--lead .promo-image {
        height: 100%;
      }
      .promo--lead .promo-body {
        justify-content: center;
        padding: 2rem 2.25rem;
      }
    }
    .promo-label {
      align-self: flex-start;
      padding: 0.3rem 0.6rem;
      background: var(--color-lavender-tint);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-indigo);
    }
    .is-armed:not(.is-open) .pack-actions {
      visibility: hidden;
    }
    .is-open .pack {
      display: none;
    }
  </style>

  <script>
    // The Crossbell Pack, modelled on how card apps open packs (Pokemon TCG
    // Pocket's swipe-to-tear, then pulling the card out):
    //
    //  1. Idle   the pack tilts a few degrees and its foil catches the light
    //            under the finger or cursor.
    //  2. Tear   a sideways drag rips the top strip exactly as far as the
    //            finger has gone (--p, 0..1), either direction. Let go before
    //            55% and it springs back; past that it finishes on its own.
    //  3. Pull   the card peeks out of the open pack; drag it up and out.
    //  4. Reveal the pack drops away, the card comes forward, one sweep of
    //            light, then a gentle holo tilt under the finger.
    //
    // A plain tap (or Enter/Space) plays the whole thing hands-free. Reduced
    // motion gets a short fade and no tilt. Plain Web Animations and pointer
    // events; nothing to load.
    const scene = document.querySelector<HTMLElement>("[data-pack-scene]");
    const stage = scene?.querySelector<HTMLElement>(".pack-stage");
    const pack = scene?.querySelector<HTMLButtonElement>("[data-pack]");
    const inner = scene?.querySelector<HTMLElement>("[data-pack-inner]");
    const tearOff = scene?.querySelector<HTMLElement>("[data-tear-off]");
    const body = scene?.querySelector<HTMLElement>(".pack-body");
    const cardWrap = scene?.querySelector<HTMLElement>("[data-pack-card]");
    const actions = scene?.querySelector<HTMLElement>("[data-pack-actions]");
    const replay = scene?.querySelector<HTMLButtonElement>("[data-pack-replay]");
    const hint = scene?.querySelector<HTMLElement>("[data-pack-hint]");

    if (scene && stage && pack && inner && tearOff && body && cardWrap && actions && replay && hint) {
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const ease = "cubic-bezier(0.2, 0, 0, 1)";
      const tucked = "translateY(4%) scale(0.88)";
      const peek = "translateY(-16%) scale(0.88)";
      // Mouse users drag and click; touch users swipe and tap.
      const mouse = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
      const HINT_CLOSED = mouse
        ? "Drag across the top to tear it open, or just click."
        : hint.textContent ?? "";
      hint.textContent = HINT_CLOSED;
      const HINT_TORN = mouse ? "Now drag the card up and out \u2191" : "Now pull the card up and out \u2191";

      type Phase = "closed" | "tearing" | "torn" | "revealing" | "open";
      let phase: Phase = "closed";
      let tear = 0; // --p
      let touched = false;
      let lastTick = 0;

      const run = (el: Element, keyframes: Keyframe[], options: KeyframeAnimationOptions) =>
        el.animate(keyframes, { fill: "both", easing: ease, ...options }).finished;
      const clamp = (v: number, lo = 0, hi = 1) => Math.min(hi, Math.max(lo, v));
      const setTear = (v: number) => {
        tear = v;
        scene.style.setProperty("--p", v.toFixed(4));
        // A light tick every tenth of the way, on phones that support it.
        const tick = Math.floor(v * 10);
        if (tick > lastTick) navigator.vibrate?.(5);
        lastTick = tick;
      };
      // Tween --p (CSS variables can't be animated with WAAPI everywhere).
      const tweenTear = (to: number, ms: number) =>
        new Promise<void>((resolve) => {
          const from = tear;
          const t0 = performance.now();
          const step = (now: number) => {
            const k = clamp((now - t0) / ms);
            const e = 1 - Math.pow(1 - k, 3);
            setTear(from + (to - from) * e);
            if (k < 1) requestAnimationFrame(step);
            else resolve();
          };
          requestAnimationFrame(step);
        });
      const setHint = (text: string) => {
        if (hint.textContent !== text) hint.textContent = text;
      };

      // ---- 1. tilt + foil ----
      const aim = (el: HTMLElement, e: PointerEvent, x: string, y: string) => {
        const r = el.getBoundingClientRect();
        el.style.setProperty(x, (clamp((e.clientX - r.left) / r.width) * 2 - 1).toFixed(3));
        el.style.setProperty(y, (clamp((e.clientY - r.top) / r.height) * 2 - 1).toFixed(3));
      };
      const settle = (el: HTMLElement, x: string, y: string) => {
        el.style.setProperty(x, "0");
        el.style.setProperty(y, "0");
      };
      if (!reduced) {
        stage.addEventListener("pointermove", (e) => {
          if (phase === "closed" || phase === "tearing" || phase === "torn") {
            aim(pack, e, "--mx", "--my");
            pack.style.setProperty("--shine", "0.9");
          }
        });
        stage.addEventListener("pointerleave", () => {
          settle(pack, "--mx", "--my");
          pack.style.removeProperty("--shine");
        });
      }

      // ---- 2. tear, 3. pull ----
      let drag: { id: number; x: number; y: number; moved: boolean; mode: "none" | "tear" | "pull" } | null = null;
      let suppressClick = false;

      stage.addEventListener("pointerdown", (e) => {
        // Each touch starts clean: after a drag, the click can land on the
        // stage rather than the pack, so a stale flag would eat the next tap.
        suppressClick = false;
        if (phase !== "closed" && phase !== "torn") return;
        touched = true;
        drag = { id: e.pointerId, x: e.clientX, y: e.clientY, moved: false, mode: "none" };
      });

      stage.addEventListener("pointermove", (e) => {
        if (!drag || e.pointerId !== drag.id) return;
        const dx = e.clientX - drag.x;
        const dy = e.clientY - drag.y;
        const w = pack.getBoundingClientRect().width;
        if (drag.mode === "none") {
          if (Math.hypot(dx, dy) < 8) return;
          drag.moved = true;
          if (phase === "closed" && Math.abs(dx) > Math.abs(dy)) {
            drag.mode = "tear";
            phase = "tearing";
            scene.classList.toggle("is-rtl", dx < 0);
            scene.classList.add("is-tearing");
            stage.setPointerCapture(e.pointerId);
          } else if (phase === "torn" && dy < 0) {
            drag.mode = "pull";
            stage.setPointerCapture(e.pointerId);
          } else {
            drag = null; // a scroll, not ours
            return;
          }
        }
        if (drag.mode === "tear") {
          const dir = scene.classList.contains("is-rtl") ? -1 : 1;
          setTear(clamp((dx * dir) / (w * 0.8)));
          if (tear >= 1) {
            drag = null;
            completeTear();
          }
        } else if (drag.mode === "pull") {
          const h = cardWrap.getBoundingClientRect().height;
          const lift = clamp(-dy / h, 0, 0.6);
          cardWrap.getAnimations().forEach((a) => a.cancel());
          cardWrap.style.transform = `translateY(${-16 - lift * 60}%) scale(${0.88 + lift * 0.1})`;
          if (lift > 0.32) {
            drag = null;
            reveal();
          }
        }
      });

      const endDrag = (e: PointerEvent) => {
        if (!drag || e.pointerId !== drag.id) return;
        const d = drag;
        drag = null;
        if (d.moved) suppressClick = true;
        if (d.mode === "tear") {
          if (tear > 0.55) completeTear();
          else {
            scene.classList.remove("is-tearing");
            tweenTear(0, 260).then(() => {
              if (phase === "tearing") phase = "closed";
            });
          }
        } else if (d.mode === "pull") {
          cardWrap.style.transform = "";
          run(cardWrap, [{ transform: getComputedStyle(cardWrap).transform }, { transform: peek }], { duration: 260 });
        }
      };
      stage.addEventListener("pointerup", endDrag);
      stage.addEventListener("pointercancel", endDrag);

      const completeTear = async () => {
        if (phase !== "tearing" && phase !== "closed") return;
        phase = "revealing"; // locks input during the flourish
        scene.classList.add("is-tearing");
        await tweenTear(1, 140);
        navigator.vibrate?.(18);
        const dir = scene.classList.contains("is-rtl") ? -1 : 1;
        run(tearOff, [
          { transform: getComputedStyle(tearOff).transform, opacity: 1 },
          { transform: `translate(${dir * 30}%, -170%) rotate(${dir * -28}deg)`, opacity: 0 },
        ], { duration: 520, easing: "cubic-bezier(0.3, 0, 0.6, 1)" });
        scene.classList.remove("is-tearing");
        await run(cardWrap, [{ transform: tucked }, { transform: peek }], { duration: 520, delay: 120 });
        scene.classList.add("is-torn");
        phase = "torn";
        setHint(HINT_TORN);
        cardWrap.querySelector(".card:not([hidden])")?.animate(
          [{ transform: "translateY(0)" }, { transform: "translateY(-3%)" }, { transform: "translateY(0)" }],
          { duration: 700, delay: 400, easing: "ease-in-out" },
        );
      };

      // ---- 4. reveal ----
      const reveal = async () => {
        if (phase === "revealing" || phase === "open") return;
        phase = "revealing";
        scene.classList.add("is-opening");
        const from = cardWrap.style.transform || getComputedStyle(cardWrap).transform;
        cardWrap.style.transform = "";
        cardWrap.style.zIndex = "3";
        navigator.vibrate?.([10, 40, 14]);
        try {
          await Promise.all([
            run(body, [{ transform: "none", opacity: 1 }, { transform: "translateY(18%)", opacity: 0 }], { duration: 360, easing: "ease-in" }),
            run(pack, [{ opacity: 1 }, { opacity: 0 }], { duration: 360, delay: 120 }),
            run(cardWrap, [{ transform: from }, { transform: "translateY(-6%) scale(1.03)", offset: 0.6 }, { transform: "none" }], { duration: 620 }),
          ]);
        } catch {
          // An interrupted animation must not strand anyone at a closed pack.
        }
        finish();
      };

      const finish = () => {
        scene.classList.remove("is-opening", "is-torn", "is-tearing");
        scene.classList.add("is-open");
        phase = "open";
        cardWrap.inert = false;
        cardWrap.querySelector<HTMLElement>(".card:not([hidden]) .card-title")?.focus({ preventScroll: true });
        if (!reduced) {
          run(actions, [{ opacity: 0, transform: "translateY(6px)" }, { opacity: 1, transform: "none" }], { duration: 300 });
          cardWrap.querySelector(".card:not([hidden])")?.animate(
            [{ transform: "translateX(-130%)" }, { transform: "translateX(130%)" }],
            { duration: 900, delay: 80, easing: "ease-in-out", pseudoElement: "::after" },
          );
        }
      };

      // Holo tilt on the revealed card
      if (!reduced) {
        cardWrap.addEventListener("pointermove", (e) => {
          if (phase !== "open") return;
          const face = cardWrap.querySelector<HTMLElement>(".card:not([hidden])");
          if (!face) return;
          aim(face, e, "--cx", "--cy");
          face.classList.add("is-lit");
        });
        cardWrap.addEventListener("pointerleave", () => {
          const face = cardWrap.querySelector<HTMLElement>(".card:not([hidden])");
          if (!face) return;
          settle(face, "--cx", "--cy");
          face.classList.remove("is-lit");
        });
      }

      // ---- tap / keyboard: the whole thing, hands-free ----
      const autoOpen = async () => {
        if (reduced) {
          if (phase !== "closed") return;
          phase = "revealing";
          scene.classList.add("is-opening");
          cardWrap.style.zIndex = "3";
          try {
            await Promise.all([
              run(pack, [{ opacity: 1 }, { opacity: 0 }], { duration: 200 }),
              run(cardWrap, [{ opacity: 0, transform: "none" }, { opacity: 1, transform: "none" }], { duration: 200 }),
            ]);
          } catch {}
          finish();
          return;
        }
        if (phase === "torn") return reveal();
        if (phase !== "closed") return;
        phase = "tearing";
        scene.classList.remove("is-rtl");
        scene.classList.add("is-tearing");
        await tweenTear(1, 420);
        await completeTear();
        await new Promise((r) => setTimeout(r, 150));
        reveal();
      };

      pack.addEventListener("click", () => {
        if (suppressClick) {
          suppressClick = false;
          return;
        }
        autoOpen();
      });

      // One unprompted half-second "show me" peel, the way games nudge you,
      // only if nobody has touched the pack yet. Not repeated.
      if (!reduced) {
        setTimeout(async () => {
          if (touched || phase !== "closed") return;
          scene.classList.add("is-tearing");
          await tweenTear(0.14, 380);
          await tweenTear(0, 420);
          scene.classList.remove("is-tearing");
          lastTick = 0;
        }, 2200);
      }

      // ---- replay ----
      replay.addEventListener("click", () => {
        [pack, inner, tearOff, body, cardWrap, actions].forEach((el) => el.getAnimations().forEach((a) => a.cancel()));
        cardWrap.querySelectorAll(".card").forEach((c) => c.getAnimations({ subtree: true }).forEach((a) => a.cancel()));
        cardWrap.style.transform = "";
        cardWrap.style.zIndex = "";
        cardWrap.inert = true;
        scene.classList.remove("is-open", "is-torn", "is-tearing", "is-opening", "is-rtl");
        setTear(0);
        lastTick = 0;
        phase = "closed";
        setHint(HINT_CLOSED);
        pack.focus();
      });
    }
  </script>
</Layout>

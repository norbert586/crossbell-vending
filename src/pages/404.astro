---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import crest from "../assets/brand/crest.png";

const title = "Page Not Found | Crossbell Vending";
const description = "That page doesn't exist. Find your way back to Crossbell Vending.";
---

<Layout title={title} description={description}>
  <section class="py-20 text-center sm:py-28">
    <div class="mx-auto max-w-[1120px] px-5 sm:px-8">
      <Image
        src={crest}
        alt=""
        width={240}
        height={279}
        densities={[1, 2]}
        class="mx-auto mb-6 h-[120px] w-auto"
        loading="eager"
      />
      <p class="font-mono text-sm font-semibold text-accent-dim">404</p>
      <h1 class="mt-3 text-[clamp(2rem,4vw,2.75rem)] font-bold">Page not found</h1>
      <p class="mx-auto mt-3 max-w-[46ch] text-lg text-muted">
        The page you're looking for moved or doesn't exist. Head back to the home page or call us
        directly.
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-3.5">
        <a
          href="/"
          class="inline-flex items-center rounded-[3px] bg-accent px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-accent-hover"
        >
          Back to home
        </a>
        <a
          href={`tel:${site.phoneTel}`}
          class="inline-flex items-center rounded-[3px] border-2 border-ink px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-ink hover:text-paper"
        >
          Call {site.phone}
        </a>
      </div>
    </div>
  </section>
</Layout>

---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import FaqItem from "../components/FaqItem.astro";
import ContactSection from "../components/ContactSection.astro";
import ServiceAreaSection from "../components/ServiceAreaSection.astro";
import MachineLineup from "../components/MachineLineup.astro";
import CardMachineArt from "../components/CardMachineArt.astro";
import { site } from "../data/site";
import { machineCommon, machineWidthRange, machines } from "../data/machines";
import kirkwayCooler from "../assets/photos/kirkway-cooler.jpg";
import imgColdDrinks from "../assets/photos/04-colddrinks.png";
import imgEnergy from "../assets/photos/05-energysports.png";
import imgSnacks from "../assets/photos/06-snacks.png";
import imgHealthy from "../assets/photos/07-healthy.png";
import imgProtein from "../assets/photos/08-protein.png";
import imgPremium from "../assets/photos/09-premiumluxury.png";

const title = "Free Smart Cooler Vending | Macomb & North Oakland County";
const description =
  "Free smart coolers for break rooms, gyms, apartment communities, auto shops, offices, and schools across Macomb and north Oakland County. We deliver it, stock it, and keep it running.";

// Carousel cards. Images are product lineups on white, shown uncropped.
const inside = [
  { group: "Food & drink", label: "Cold drinks", blurb: "Water, soda, iced tea, and juice, always cold.", image: imgColdDrinks, alt: "Bottled water, Coca-Cola, Diet Coke, Sprite, Pure Leaf tea, Tropicana, and Gatorade" },
  { group: "Food & drink", label: "Energy & sports", blurb: "Energy drinks, electrolytes, and cold brew for long shifts and hard workouts.", image: imgEnergy, alt: "Monster, Red Bull, Bang, Gatorade, Celsius, and Starbucks cold brew" },
  { group: "Food & drink", label: "Snacks", blurb: "Chips, candy, jerky, and trail mix. The ones people actually reach for.", image: imgSnacks, alt: "Doritos, Lay's, Ruffles, Takis, Snickers, M&M's, Planters trail mix, and Jack Link's jerky" },
  { group: "Food & drink", label: "Healthier picks", blurb: "Protein bars, nuts, fruit cups, and low-sugar drinks.", image: imgHealthy, alt: "RXBAR, KIND bar, Blue Diamond almonds, Chobani yogurt, GoGo squeeZ, Naked juice, Olipop, and That's It fruit bar" },
  { group: "Food & drink", label: "Protein & meals", blurb: "Protein shakes and ready-to-eat options where the site calls for them.", image: imgProtein, alt: "Premier Protein, Fairlife, and Atkins shakes, a chicken teriyaki entrée, hard-boiled eggs, and Sargento Balanced Breaks" },
  { group: "Premium amenities", label: "Premium & luxury", blurb: "Higher-end snacks, drinks, and personal items that set your break room apart.", image: imgPremium, alt: "Pokémon trading card packs, BlenderBottle shakers, Beats Studio Buds, Altoids, and 5 gum" },
] as const;

// Things a host can hold us to. Each one is backed elsewhere on the site or
// in the agreement; don't add one that isn't.
const promises = [
  { head: "A reply by end of business day", body: "Every call, text, and email, from the person who runs your route." },
  { head: "A replacement within 48 hours", body: "If a unit needs more than a quick fix, we swap it rather than leave you with a dark cooler." },
  { head: "A full cooler every week", body: "Restocked on a set route, and sooner when remote monitoring shows a gap." },
  { head: "Stock your people pick", body: "Requests from the QR code on the door come straight to us, and we stock what sells at your site." },
  { head: "An honest read on your current vendor", body: "If the company you have is doing a good job, we'll tell you to keep them." },
  { head: "Insurance on file", body: "Fully insured, with your business named as additional insured. Certificate on request." },
];

const icons: Record<(typeof site.locationTypes)[number]["icon"] | "plus", string> = {
  plus: '<line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>',
  mug: '<path d="M4 8h13v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8Z"/><path d="M17 9h1.5a2.5 2.5 0 0 1 0 5H17"/><line x1="7" y1="4" x2="7" y2="6"/><line x1="10.5" y1="3.5" x2="10.5" y2="6"/>',
  barbell: '<rect x="2" y="10" width="4" height="4"/><rect x="18" y="10" width="4" height="4"/><line x1="6" y1="12" x2="18" y2="12"/>',
  wrench: '<path d="M14 7l3 3-6 6-3.5.5.5-3.5Z"/><path d="M12 9l3 3"/><path d="M4 20h6"/>',
  building: '<rect x="5" y="3" width="14" height="17"/><path d="M9 7h2M13 7h2M9 11h2M13 11h2M9 15h2M13 15h2"/><path d="M10.5 20v-3h3v3"/>',
  desk: '<rect x="3" y="6" width="18" height="4"/><line x1="6" y1="10" x2="6" y2="19"/><line x1="18" y1="10" x2="18" y2="19"/><line x1="9" y1="14" x2="15" y2="14"/>',
  school: '<path d="M3 10l9-5 9 5-9 5-9-5Z"/><path d="M7 12v5c0 1.5 2.5 2.5 5 2.5s5-1 5-2.5v-5"/><line x1="21" y1="10" x2="21" y2="16"/>',
  boxes: '<rect x="3" y="12" width="8" height="8"/><rect x="13" y="12" width="8" height="8"/><rect x="8" y="4" width="8" height="8"/>',
};
---

<Layout title={title} description={description} contactHref="#contact">
  <!-- Hero: a real Crossbell placement, not a render. -->
  <section class="bg-indigo text-paper">
    <div class="grid md:grid-cols-[1.12fr_0.88fr]">
      <div
        class="flex flex-col justify-center px-5 py-14 sm:px-8 sm:py-16 md:pr-12 md:pl-[max(2rem,calc((100vw-1120px)/2+2rem))] lg:py-20"
      >
        <p class="text-sm font-semibold text-accent">Locally owned in Macomb County &middot; Fully insured</p>
        <h1 class="mt-4 max-w-[15ch] text-[clamp(2.7rem,5vw,4.4rem)] leading-[0.98] font-bold text-white">
          <span class="text-accent">Free</span> smart coolers for Macomb and north Oakland.
        </h1>
        <p class="mt-6 max-w-[46ch] text-lg leading-relaxed text-lavender">
          We deliver the cooler, stock it, and service it every week at no cost to your business.
          Your people get cold drinks, snacks, and fresh options any time. You provide the spot and
          a standard outlet.
        </p>
        <div class="mt-8 flex flex-wrap gap-3.5">
          <a
            href="#contact"
            class="inline-flex min-h-11 items-center rounded-[3px] bg-accent px-6 py-3.5 text-sm font-semibold text-ink transition-colors hover:bg-accent-hover"
          >
            Request a walkthrough
          </a>
          <a
            href={`tel:${site.phoneTel}`}
            class="inline-flex min-h-11 items-center rounded-[3px] border-2 border-lavender px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-white hover:text-indigo"
          >
            Call {site.phone}
          </a>
        </div>
        <a href="/services/#card-machines" class="group mt-9 inline-flex items-center gap-2 self-start text-sm text-lavender hover:text-white">
          <span class="bg-accent px-1.5 py-0.5 font-mono text-[0.62rem] font-bold tracking-[0.12em] text-ink">NEW</span>
          Trading card machines for family venues
          <span aria-hidden="true" class="text-accent transition-transform group-hover:translate-x-0.5">&rarr;</span>
        </a>
      </div>
      <figure class="relative min-h-[440px] sm:min-h-[520px] md:min-h-[620px]">
        <Image
          src={kirkwayCooler}
          alt="A Crossbell smart cooler stocked with drinks and snacks, standing in the hallway of a local apartment community"
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 768px) 44vw, 100vw"
          class="absolute inset-0 h-full w-full object-cover object-[50%_62%]"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption class="absolute bottom-4 left-4 bg-white/92 px-3 py-2 text-xs font-semibold text-ink backdrop-blur-sm sm:bottom-6 sm:left-6">
          In service at a local apartment community
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="bg-accent text-ink" aria-label="At a glance">
    <div class="mx-auto grid max-w-[1120px] divide-y divide-ink/20 px-5 sm:grid-cols-3 sm:divide-x sm:divide-y-0 sm:px-8">
      <div class="py-6 sm:pr-8">
        <div class="font-display text-4xl leading-none font-bold">Free</div>
        <p class="mt-2 text-sm font-medium">Machine, delivery, product, and service, all on us.</p>
      </div>
      <div class="py-6 sm:px-8">
        <div class="font-display text-4xl leading-none font-bold">Same day</div>
        <p class="mt-2 text-sm font-medium">Replies by end of business day. A replacement unit within 48 hours.</p>
      </div>
      <div class="py-6 sm:pl-8">
        <div class="font-display text-4xl leading-none font-bold">Weekly</div>
        <p class="mt-2 text-sm font-medium">Restocked on a set route and watched remotely in between.</p>
      </div>
    </div>
  </section>

  <section id="how" class="scroll-mt-20 py-14 sm:py-20">
    <div class="mx-auto max-w-[1120px] px-5 sm:px-8">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-[clamp(2rem,3.6vw,2.8rem)] font-semibold">How it works</h2>
        <p class="max-w-[42ch] text-muted">Your part takes about ten minutes. Everything after that is on us.</p>
      </div>
      <ol class="grid gap-8 sm:grid-cols-3 sm:gap-7">
        <li class="border-t-[3px] border-ink pt-4">
          <div class="font-display text-5xl leading-none font-bold text-accent">1</div>
          <h3 class="mt-3 text-[1.6rem] font-semibold">We walk your space</h3>
          <p class="mt-2 text-[0.98rem] text-muted">
            Ten minutes. We measure, find the outlet, and agree on the best spot for the cooler.
          </p>
        </li>
        <li class="border-t-[3px] border-ink pt-4">
          <div class="font-display text-5xl leading-none font-bold text-accent">2</div>
          <h3 class="mt-3 text-[1.6rem] font-semibold">We wheel it in and stock it</h3>
          <p class="mt-2 text-[0.98rem] text-muted">
            We deliver the cooler, set it up, and fill it. All you supply is a standard wall outlet.
          </p>
        </li>
        <li class="border-t-[3px] border-ink pt-4">
          <div class="font-display text-5xl leading-none font-bold text-accent">3</div>
          <h3 class="mt-3 text-[1.6rem] font-semibold">We keep it running</h3>
          <p class="mt-2 text-[0.98rem] text-muted">
            Restocked weekly and watched remotely. If you need anything, you hear back the same day.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="bg-indigo text-paper" aria-labelledby="cost-heading">
    <div class="mx-auto max-w-[1120px] px-5 py-14 sm:px-8 sm:py-20">
      <div class="grid gap-10 md:grid-cols-[1fr_1fr] md:items-center">
        <div>
          <h2 id="cost-heading" class="text-2xl font-semibold text-lavender">What it costs your business</h2>
          <div class="mt-1 font-display text-[clamp(5rem,12vw,8.5rem)] leading-none font-bold text-accent" aria-hidden="true">FREE</div>
          <p class="sr-only">Nothing. It is free.</p>
          <p class="mt-5 max-w-[50ch] text-[1.05rem] text-lavender">
            We buy the machine, wheel it in, stock it, and service it. Nothing is billed to your
            business: no rental, no delivery charge, no service call.
          </p>
          <p class="mt-3.5 max-w-[50ch] text-[1.05rem] text-lavender">
            The cooler is an amenity for the people at your site. We earn on what sells, so we have
            every reason to keep it full of what they actually want.
          </p>
        </div>
        <div class="border border-indigo-2 bg-[#1f1f4a80] p-6 sm:p-8">
          <ul class="flex flex-col gap-3.5">
            <li class="flex justify-between gap-4">
              <span class="text-paper">The machine</span>
              <strong class="flex-none font-mono text-accent">$0.00</strong>
            </li>
            <li class="flex justify-between gap-4">
              <span class="text-paper">Delivery and setup</span>
              <strong class="flex-none font-mono text-accent">$0.00</strong>
            </li>
            <li class="flex justify-between gap-4">
              <span class="text-paper">Product and restocking</span>
              <strong class="flex-none font-mono text-accent">$0.00</strong>
            </li>
            <li class="flex justify-between gap-4">
              <span class="text-paper">Service and repairs</span>
              <strong class="flex-none font-mono text-accent">$0.00</strong>
            </li>
            <li class="flex justify-between gap-4 border-t border-indigo-2 pt-3.5">
              <span class="font-semibold text-paper">Your cost</span>
              <strong class="flex-none font-mono text-lg text-accent">$0.00</strong>
            </li>
          </ul>
          <p class="mt-5 border-t border-indigo-2 pt-4 text-sm text-lavender">
            One offer, no tiers. All we need from you is a spot and a standard outlet. The cooler
            draws about what a household fridge does.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- The machine: the whole line, drawn to scale. -->
  <section id="machine" class="scroll-mt-20 py-14 sm:py-20">
    <div class="mx-auto max-w-[1120px] px-5 sm:px-8">
      <div class="grid gap-8 md:grid-cols-[1fr_1fr] md:gap-14">
        <div>
          <h2 class="text-[clamp(2rem,3.6vw,2.8rem)] font-semibold">Pick the size that fits your wall.</h2>
          <p class="mt-4 max-w-[50ch] text-muted">
            Every Crossbell cooler works the same way: tap a card or phone to unlock it, take what
            you want, close the door. The cooler recognizes what left the shelf and charges for
            exactly that. The sizes differ only in how much floor they take and how much they hold.
          </p>
        </div>
        <dl class="grid content-start gap-x-8 gap-y-5 border-t border-line pt-5 sm:grid-cols-2 md:mt-2">
          <div>
            <dt class="text-sm font-semibold">Footprint</dt>
            <dd class="mt-1 text-[0.98rem] text-muted">{machineWidthRange.min}" to {machineWidthRange.max}" wide. The smallest is about the size of a household fridge.</dd>
          </div>
          <div>
            <dt class="text-sm font-semibold">Payment</dt>
            <dd class="mt-1 text-[0.98rem] text-muted">{machineCommon.payment}</dd>
          </div>
          <div>
            <dt class="text-sm font-semibold">Power</dt>
            <dd class="mt-1 text-[0.98rem] text-muted">{machineCommon.power}</dd>
          </div>
          <div>
            <dt class="text-sm font-semibold">Monitoring</dt>
            <dd class="mt-1 text-[0.98rem] text-muted">Inventory reports to us remotely, so low items get restocked early.</dd>
          </div>
        </dl>
      </div>

      <div class="mt-12 border border-line bg-white px-5 pt-8 pb-5 sm:px-8">
        <MachineLineup />
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a
          href="/machines/"
          class="inline-flex min-h-11 items-center rounded-[3px] bg-accent px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-accent-hover"
        >
          Compare all {machines.length} sizes &rarr;
        </a>
        <a href="/services/" class="text-sm font-semibold text-ink underline decoration-accent decoration-2 underline-offset-4">
          Need more than one cooler? See smart markets
        </a>
      </div>
    </div>
  </section>

  <section class="bg-lavender-tint py-14 sm:py-20" aria-labelledby="places-heading">
    <div class="mx-auto max-w-[1120px] px-5 sm:px-8">
      <h2 id="places-heading" class="mb-10 text-[clamp(2rem,3.6vw,2.8rem)] font-semibold">Anywhere people spend their day</h2>
      <ul class="grid grid-cols-2 gap-px border border-line bg-line sm:grid-cols-4">
        {site.locationTypes.map((p) => (
          <li class="flex flex-col items-center gap-2.5 bg-white p-6 text-center">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-[26px] w-[26px] text-indigo" aria-hidden="true" set:html={icons[p.icon]} />
            <span class="text-sm font-semibold">{p.plural}</span>
          </li>
        ))}
        <li class="flex flex-col items-center gap-2.5 bg-lavender-tint p-6 text-center text-indigo/70">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-[26px] w-[26px]" aria-hidden="true" set:html={icons.plus} />
          <span class="text-sm font-semibold">And many more</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- What's inside: scroll-snap carousel, arrows are progressive enhancement -->
  <section id="inside" class="scroll-mt-20 py-14 sm:py-20">
    <div class="mx-auto max-w-[1120px] px-5 sm:px-8">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-6">
        <h2 class="max-w-[24ch] text-[clamp(2rem,3.6vw,2.8rem)] font-semibold">What goes inside, picked for your site</h2>
        <div class="flex items-center gap-2">
          <span data-carousel-status class="mr-1 font-mono text-xs font-semibold text-muted" aria-live="polite">
            1 / {inside.length}
          </span>
          <button
            type="button"
            data-carousel-prev
            aria-label="Previous items"
            aria-controls="product-carousel"
            class="flex h-11 w-11 items-center justify-center border-2 border-ink bg-white text-ink transition-colors hover:bg-ink hover:text-paper disabled:cursor-not-allowed disabled:border-muted/40 disabled:text-muted/40 disabled:hover:bg-white"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
          </button>
          <button
            type="button"
            data-carousel-next
            aria-label="Next items"
            aria-controls="product-carousel"
            class="flex h-11 w-11 items-center justify-center border-2 border-ink bg-white text-ink transition-colors hover:bg-ink hover:text-paper disabled:cursor-not-allowed disabled:border-muted/40 disabled:text-muted/40 disabled:hover:bg-white"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </button>
        </div>
      </div>
    </div>
    <div class="mx-auto max-w-[1120px] sm:px-8">
      <ul
        id="product-carousel"
        data-carousel
        class="carousel flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth px-5 pb-4 sm:px-0"
        aria-label="Product categories"
      >
        {inside.map((item) => (
          <li class="flex w-[240px] flex-none snap-start flex-col border border-line bg-white sm:w-[280px]">
            <div class="flex aspect-[4/3] items-center justify-center border-b border-line bg-white p-4">
              <Image
                src={item.image}
                alt={item.alt}
                widths={[280, 560]}
                sizes="280px"
                class="max-h-full w-auto max-w-full object-contain"
                loading="lazy"
              />
            </div>
            <div class="p-5">
              <p class="text-xs font-semibold text-accent-dim">{item.group}</p>
              <h3 class="mt-1 text-[1.4rem] font-semibold">{item.label}</h3>
              <p class="mt-1.5 text-sm text-muted">{item.blurb}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
    <script>
      // Arrow buttons scroll one card at a time. Without JS the list still
      // scrolls by touch, trackpad, or keyboard.
      document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((track) => {
        const section = track.closest("section");
        const previous = section?.querySelector<HTMLButtonElement>("[data-carousel-prev]");
        const next = section?.querySelector<HTMLButtonElement>("[data-carousel-next]");
        const status = section?.querySelector<HTMLElement>("[data-carousel-status]");
        const step = () => ((track.firstElementChild as HTMLElement | null)?.offsetWidth ?? 280) + 16;

        const update = () => {
          const max = track.scrollWidth - track.clientWidth;
          if (previous) previous.disabled = track.scrollLeft <= 2;
          if (next) next.disabled = track.scrollLeft >= max - 2;
          if (status) {
            const current = Math.min(track.children.length, Math.round(track.scrollLeft / step()) + 1);
            status.textContent = `${current} / ${track.children.length}`;
          }
        };

        previous?.addEventListener("click", () => {
          track.scrollBy({ left: -step(), behavior: "smooth" });
        });
        next?.addEventListener("click", () => {
          track.scrollBy({ left: step(), behavior: "smooth" });
        });
        track.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update);
        requestAnimationFrame(update);
      });
    </script>
  </section>

  <!-- New format teaser. The full pitch lives on /services/#card-machines. -->
  <section class="overflow-hidden bg-ink text-paper" aria-labelledby="cards-teaser-heading">
    <div class="mx-auto grid max-w-[1120px] items-center gap-10 px-5 py-14 sm:px-8 sm:py-16 md:grid-cols-[1.25fr_0.75fr] md:gap-14">
      <div>
        <p class="flex items-center gap-3 text-sm font-semibold text-lavender">
          <span class="bg-accent px-2 py-0.5 font-mono text-[0.66rem] font-bold tracking-[0.12em] text-ink">NEW</span>
          For rinks, bowling centers, and family venues
        </p>
        <h2 id="cards-teaser-heading" class="mt-4 max-w-[18ch] text-[clamp(2.2rem,4.4vw,3.4rem)] leading-[0.98] font-bold text-white">
          Now placing trading card machines.
        </h2>
        <p class="mt-5 max-w-[52ch] text-lg leading-relaxed text-lavender">
          Factory-sealed Pokémon booster packs in a compact, tap-to-pay machine that hangs on a wall
          or sits on a counter. Same deal as our coolers: we supply it, stock it, and service it.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a
            href="/services/#card-machines"
            class="inline-flex min-h-11 items-center rounded-[3px] bg-accent px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-accent-hover"
          >
            How card machines work
          </a>
          <a href="/contact/?service=card-machine" class="text-sm font-semibold text-white underline decoration-accent decoration-2 underline-offset-4">
            Ask about one for your venue
          </a>
        </div>
      </div>
      <div class="relative mx-auto w-full max-w-[300px] md:max-w-none">
        <CardMachineArt class="relative block h-auto w-full" />
      </div>
    </div>
  </section>

  <section id="why" class="scroll-mt-20 py-14 sm:py-20" aria-labelledby="why-heading">
    <div class="mx-auto max-w-[1120px] px-5 sm:px-8">
      <div class="mb-10 grid gap-4 md:grid-cols-[1fr_1fr] md:items-end md:gap-14">
        <h2 id="why-heading" class="text-[clamp(2rem,3.6vw,2.8rem)] font-semibold">What you can hold us to</h2>
        <p class="max-w-[48ch] text-muted md:justify-self-end">
          Crossbell is a small, local operator. These are the things we'll answer for if we slip.
        </p>
      </div>
      <ol class="grid gap-x-10 sm:grid-cols-2 lg:grid-cols-3">
        {promises.map((p, i) => (
          <li class="grid grid-cols-[2.25rem_1fr] border-t-2 border-ink py-6">
            <span class="font-mono text-sm font-bold text-accent-dim">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3 class="text-[1.55rem] leading-tight font-semibold">{p.head}</h3>
              <p class="mt-2 text-[0.96rem] text-muted">{p.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <ServiceAreaSection />

  <section id="faq" class="scroll-mt-20 py-14 sm:py-20">
    <div class="mx-auto grid max-w-[1120px] gap-10 px-5 sm:px-8 lg:grid-cols-[0.75fr_1.25fr] lg:gap-16">
      <div>
        <h2 class="text-[clamp(2rem,3.6vw,2.8rem)] font-semibold">Questions we get</h2>
        <p class="mt-3 max-w-[34ch] text-muted">
          Something else? Call <a href={`tel:${site.phoneTel}`} class="font-semibold whitespace-nowrap text-ink underline decoration-accent decoration-2 underline-offset-4">{site.phone}</a>.
          You'll talk to the person who runs the route.
        </p>
      </div>
      <div>
        <FaqItem question="What does this cost us?" open>
          <p>
            Nothing. The machine, delivery, product, restocking, and service are all free. The
            cooler is an amenity for your site. We earn on what sells, so we have every reason to
            keep it full of what your people actually buy.
          </p>
        </FaqItem>
        <FaqItem question="How big is the machine?">
          <p>
            It depends on the site. The smallest is 22.8" wide, 26" deep, and 76" tall, about the
            footprint of a household refrigerator. The largest is a 53.9" double-door cooler. Every
            one needs a standard wall outlet nearby and a little clearance for the door to swing.
            <a href="/machines/" class="text-ink underline underline-offset-2">See the full lineup.</a>
          </p>
        </FaqItem>
        <FaqItem question="What if something goes wrong with it?">
          <p>
            Call or message us and you'll hear back the same business day. We handle refunds, and
            if a unit needs more than a quick fix we can have a replacement on site within 48 hours.
          </p>
        </FaqItem>
        <FaqItem question="How long is the agreement?">
          <p>
            There's no long-term lock-in. After the first 90 days, thirty days' written notice ends
            the agreement. Because we buy, stock, and install each cooler at our own expense, an
            early-exit fee applies if you cancel inside those first 90 days. It's spelled out in the
            agreement before you sign.
          </p>
        </FaqItem>
        <FaqItem question="Are you insured?">
          <p>
            Yes. We're fully insured, with your business named as additional insured. Certificate
            available on request.
          </p>
        </FaqItem>
        <FaqItem question="What do you stock?">
          <p>
            Snacks, cold drinks, and premium products where the site calls for them. We tune the mix
            to what actually sells at your location, and your people can request items through the
            QR code on the door.
          </p>
        </FaqItem>
        <FaqItem question="Do you have trading card machines?">
          <p>
            Yes. They're compact wall or counter machines stocked with
            factory-sealed Pokémon booster packs, and they suit rinks, bowling centers, family
            venues, and apartment clubhouses.
            <a href="/services/#card-machines" class="text-ink underline underline-offset-2">How card machines work.</a>
          </p>
        </FaqItem>
        <FaqItem question="We already have a vending machine. Why switch?">
          <p>
            If the company you have is showing up and keeping it full, stay put. We'll tell you so.
            But if it sits half empty for weeks, the card reader has been down since spring, and
            nobody returns your calls, that's usually a route run from far enough away that your site
            is a line on a spreadsheet. We're local, the route is weekly, and swapping out a
            neglected unit is routine for us.
          </p>
        </FaqItem>
        <FaqItem question="Are you actually local?">
          <p>
            Yes. Crossbell is a small business based in Macomb County, and the whole route is
            Macomb and north Oakland. The person who answers the phone is the person who services
            your machine, which is also why we can sit down with your staff and stock what they ask
            for.
          </p>
        </FaqItem>
      </div>
    </div>
  </section>

  <ContactSection />
</Layout>

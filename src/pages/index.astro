---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import CardFeature from "../components/CardFeature.astro";
import FaqItem from "../components/FaqItem.astro";
import { site } from "../data/site";
import kirkwayCooler from "../assets/photos/kirkway-cooler.jpg";

const title = "Free Managed Vending & Trading Card Machines | Crossbell Vending";
const description = "Smart coolers, smart markets, and trading-card vending for Macomb and north Oakland County. Free placement, weekly restocking, and local service for qualifying businesses.";
const services = [
  { name: "Smart coolers", body: "Cold drinks, snacks, and fresh options. One door, automatic checkout.", href: "/services/#cooler-detail", link: "Explore smart coolers" },
  { name: "Smart markets", body: "More doors. More choice. An onsite store for a busier workplace.", href: "/services/#market-detail", link: "Explore smart markets" },
  { name: "Trading-card vending", body: "Pokémon and other TCG favorites, ready for your family venue.", href: "/trading-card-vending/", link: "Explore trading-card vending" },
];
---

<Layout title={title} description={description} contactHref="/contact/">
  <section class="home-hero" aria-labelledby="home-heading">
    <div class="home-hero__copy">
      <h1 id="home-heading">Modern vending.<br /><span>Handled for you.</span></h1>
      <p class="home-hero__intro">Smart coolers, markets, and trading-card machines. We bring them in, keep them stocked, and take care of the rest.</p>
      <div class="home-hero__actions">
        <a href="/contact/" class="cb-button">Request a site visit <span aria-hidden="true">&rarr;</span></a>
        <a href="#services" class="cb-text-link">See our services</a>
      </div>
      <p class="home-hero__terms">Free placement, stocking, and service for qualifying businesses.</p>
      <p class="home-hero__local">Locally owned. Fully insured.<br />Macomb &amp; north Oakland County, Michigan.</p>
    </div>
    <figure class="home-hero__photo">
      <Image src={kirkwayCooler} alt="A Crossbell smart cooler stocked with drinks and snacks at a local apartment community" widths={[480, 720, 960, 1200]} sizes="(min-width: 900px) 44vw, 100vw" loading="eager" fetchpriority="high" />
      <figcaption>A real Crossbell placement.<br /><span>A local apartment community.</span></figcaption>
    </figure>
  </section>

  <section id="services" class="home-services cb-shell cb-section" aria-labelledby="services-heading">
    <div>
      <span id="machine" class="cb-anchor" aria-hidden="true"></span>
      <span id="inside" class="cb-anchor" aria-hidden="true"></span>
      <h2 id="services-heading" class="cb-heading">Your space.<br />The right setup.</h2>
      <p class="mt-5 max-w-[33ch] leading-relaxed text-muted">A break room, a busy lobby, or a place families come to play. We help you choose what fits.</p>
      <a href="/services/" class="cb-text-link mt-6">Compare all services <span aria-hidden="true">&rarr;</span></a>
    </div>
    <ul class="home-services__list">
      {services.map((service) => (
        <li><a href={service.href} aria-label={service.link}><div><h3>{service.name}</h3><p>{service.body}</p></div><span class="home-services__arrow" aria-hidden="true">&rarr;</span></a></li>
      ))}
    </ul>
  </section>

  <CardFeature />

  <section id="how" class="cb-shell cb-section" aria-labelledby="how-heading">
    <div class="home-section-heading"><h2 id="how-heading" class="cb-heading">Your part is simple.<br />Our part is ongoing.</h2><a href="/services/#responsibilities" class="cb-text-link">What we take care of <span aria-hidden="true">&rarr;</span></a></div>
    <ol class="home-steps">
      <li><span>1</span><div><h3>We visit your space.</h3><p>A ten-minute walkthrough to check the fit, traffic, and power.</p></div></li>
      <li><span>2</span><div><h3>We install and stock it.</h3><p>The machine, delivery, setup, and products are on us.</p></div></li>
      <li><span>3</span><div><h3>We keep showing up.</h3><p>Weekly restocks and local service from the people you call.</p></div></li>
    </ol>
  </section>

  <section id="area" class="home-local" aria-labelledby="local-heading">
    <div class="cb-shell home-local__inner">
      <div><span id="why" class="cb-anchor" aria-hidden="true"></span><h2 id="local-heading" class="cb-heading">Local people.<br />A route you can rely on.</h2><p>Based in Macomb County, serving Macomb and north Oakland. The person who answers is the person who services your machine.</p><a href="/services/#area" class="cb-text-link">See our service area <span aria-hidden="true">&rarr;</span></a></div>
      <dl><div><dt>Weekly restocks</dt><dd>With remote inventory checks between visits.</dd></div><div><dt>Same-day replies</dt><dd>Hear back by the end of the business day.</dd></div><div><dt>Fully insured</dt><dd>Certificate available on request.</dd></div></dl>
    </div>
  </section>

  <section id="faq" class="cb-shell cb-section home-faq" aria-labelledby="faq-heading">
    <div><h2 id="faq-heading" class="cb-heading">A few things<br />you might ask.</h2><a href="/services/#faq" class="cb-text-link mt-5">More service questions <span aria-hidden="true">&rarr;</span></a></div>
    <div>
      <FaqItem question="What does it cost our business?">Qualifying locations pay no equipment, delivery, stocking, or service fees. We earn from product sales; your location provides the space, power, and access.</FaqItem>
      <FaqItem question="Which machine is right for our location?">We look at your space, traffic, and what people want to buy. Then we recommend a cooler, a market, a card machine, or a combination.</FaqItem>
      <FaqItem question="What is the agreement?">After the first 90 days, thirty days’ written notice ends the agreement. An early-exit fee applies within those first 90 days. We explain the terms before you sign.</FaqItem>
    </div>
  </section>

  <section id="contact" class="home-close" aria-labelledby="contact-heading">
    <div class="cb-shell"><div><h2 id="contact-heading">Let’s find your fit.</h2><p>Tell us about your location. We’ll take it from there.</p></div><div class="home-close__actions"><a href="/contact/" class="cb-button">Request a site visit <span aria-hidden="true">&rarr;</span></a><a href={`tel:${site.phoneTel}`} class="cb-text-link">Or call {site.phone}</a></div></div>
  </section>
</Layout>

<style>
  .home-hero { display: grid; grid-template-columns: 1.12fr .88fr; background: var(--color-indigo); color: var(--color-paper); }
  .home-hero__copy { padding: 5rem 3rem 4rem max(2rem, calc((100vw - 1120px) / 2 + 2rem)); align-self: center; }
  .home-hero h1 { font-size: clamp(3rem, 5.7vw, 5.65rem); line-height: .97; font-weight: 700; letter-spacing: -.02em; }
  .home-hero h1 span { color: var(--color-accent); }
  .home-hero__intro { font-size: 1.1rem; line-height: 1.75; color: var(--color-lavender); max-width: 41ch; margin-top: 1.7rem; }
  .home-hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; margin-top: 2rem; }
  .home-hero__actions .cb-text-link { color: var(--color-paper); }
  .home-hero__terms { font-size: .8rem; line-height: 1.6; color: var(--color-lavender); max-width: 43ch; margin-top: 1rem; }
  .home-hero__local { margin-top: 2.5rem; color: var(--color-lavender); font-size: .8rem; line-height: 1.7; }
  .home-hero__photo { min-height: 590px; position: relative; }
  .home-hero__photo img { position: absolute; width: 100%; height: 100%; object-fit: cover; object-position: 50% 62%; }
  .home-hero__photo figcaption { position: absolute; bottom: 1.5rem; left: 1.5rem; padding: .8rem 1rem; background: var(--color-paper); color: var(--color-ink); font-size: .75rem; font-weight: 600; line-height: 1.6; }
  .home-hero__photo figcaption span { font-weight: 400; color: var(--color-muted); }
  .home-services { display: grid; grid-template-columns: .85fr 1.15fr; gap: 5rem; }
  .home-services__list { border-top: 1px solid var(--color-line); }
  .home-services__list li { border-bottom: 1px solid var(--color-line); }
  .home-services__list a { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.5rem .5rem 1.5rem 0; }
  .home-services__list h3 { font-size: 1.8rem; font-weight: 600; }
  .home-services__list p { margin-top: .5rem; font-size: .94rem; line-height: 1.6; max-width: 44ch; color: var(--color-muted); }
  .home-services__arrow { color: var(--color-accent-dim); font-size: 1.6rem; transition: transform 250ms ease-out; }
  .home-services__list a:hover .home-services__arrow { transform: translateX(4px); }
  .home-services__list a:hover h3 { color: var(--color-indigo); text-decoration: underline; text-decoration-color: var(--color-accent); text-underline-offset: .2em; }
  .home-section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }
  .home-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; margin-top: 2.5rem; }
  .home-steps li { display: flex; gap: 1rem; border-top: 2px solid var(--color-line); padding-top: 1.5rem; }
  .home-steps li > span { font-family: var(--font-display); font-size: 2.8rem; line-height: 1; color: var(--color-accent-dim); }
  .home-steps h3 { font-size: 1.55rem; font-weight: 600; }
  .home-steps p { font-size: .94rem; color: var(--color-muted); margin-top: .6rem; line-height: 1.7; }
  .home-local { background: var(--color-lavender-tint); }
  .home-local__inner { display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: 5rem; padding-top: 3.5rem; padding-bottom: 3.5rem; }
  .home-local__inner p { max-width: 43ch; line-height: 1.75; color: var(--color-muted); margin: 1.2rem 0; }
  .home-local dl div { padding: 1.1rem 0; border-bottom: 1px solid var(--color-line); }
  .home-local dt { font-weight: 600; }
  .home-local dd { font-size: .9rem; color: var(--color-muted); margin-top: .25rem; }
  .home-faq { display: grid; grid-template-columns: .85fr 1.15fr; gap: 5rem; }
  .home-close { background: var(--color-indigo); color: var(--color-paper); }
  .home-close > div { padding-top: 3.5rem; padding-bottom: 3.5rem; display: flex; justify-content: space-between; align-items: center; gap: 2rem; }
  .home-close h2 { font-size: clamp(2.8rem, 5vw, 4rem); font-weight: 700; }
  .home-close p { color: var(--color-lavender); margin-top: .75rem; }
  .home-close__actions { display: flex; flex-direction: column; align-items: start; gap: 1rem; }
  .home-close .cb-text-link { color: var(--color-lavender); }
  @media (max-width: 899px) {
    .home-hero { grid-template-columns: 1fr; }
    .home-hero__copy { padding: 3.5rem 1.25rem 2.5rem; }
    .home-hero h1 { font-size: clamp(3rem, 10vw, 5rem); }
    .home-hero__intro { max-width: 48ch; }
    .home-hero__local { margin-top: 1.5rem; }
    .home-hero__photo { min-height: 360px; max-height: 440px; }
    .home-hero__photo img { object-position: 50% 60%; }
    .home-services, .home-faq, .home-local__inner { grid-template-columns: 1fr; gap: 2rem; }
    .home-section-heading { align-items: start; flex-direction: column; gap: 1rem; }
    .home-steps { gap: 1.5rem; }
    .home-steps li { flex-direction: column; }
    .home-close > div { align-items: start; flex-direction: column; }
  }
  @media (max-width: 599px) { .home-steps { grid-template-columns: 1fr; gap: 1.2rem; } .home-steps li { flex-direction: row; padding-top: 1.2rem; } }
</style>

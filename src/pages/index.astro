---
import Layout from "../layouts/Layout.astro";
import PhotoPlaceholder from "../components/PhotoPlaceholder.astro";
import FaqItem from "../components/FaqItem.astro";
import ContactSection from "../components/ContactSection.astro";
import { site } from "../data/site";

const title = "Vending Machine Services Macomb County | Crossbell Vending";
const description =
  "AI-powered smart coolers for break rooms, gyms, apartment communities, auto shops, and light industrial sites across Macomb and north Oakland County. No cost, no long contract.";
---

<Layout title={title} description={description} contactHref="#contact">
  <!-- Hero -->
  <section class="py-11 sm:py-16">
    <div class="mx-auto grid max-w-[1120px] items-center gap-10 px-5 sm:px-8 md:grid-cols-[1.1fr_0.9fr]">
      <div>
        <h1 class="text-[clamp(2.5rem,5.4vw,3.9rem)] font-bold leading-[1.05]">
          Smart vending for Macomb and Oakland County workplaces
        </h1>
        <p class="mt-4 max-w-[46ch] text-lg text-muted">
          We install, stock, and service AI-powered coolers in your break room. No cost, no
          contracts you can't get out of, no work for your team.
        </p>
        <div class="mt-7 flex flex-wrap gap-3.5">
          <a
            href="#contact"
            class="inline-flex items-center rounded-[3px] bg-accent px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-accent-dim"
          >
            Contact us
          </a>
          <a
            href={`tel:${site.phoneTel}`}
            class="inline-flex items-center rounded-[3px] border-2 border-ink px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-ink hover:text-paper"
          >
            Call {site.phone}
          </a>
        </div>
      </div>
      <PhotoPlaceholder
        shotId="01"
        aspect="4/5"
        label="Installed cooler in a real break room, 3/4 angle, screen and card reader visible"
      />
    </div>
  </section>

  <!-- How it works -->
  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-[1120px] px-5 sm:px-8">
      <div class="mb-9 max-w-[52ch]">
        <h2 class="text-[clamp(1.85rem,3.2vw,2.4rem)] font-semibold">How it works</h2>
      </div>
      <div class="grid gap-7 sm:grid-cols-3">
        <div class="border-t-[3px] border-ink pt-4">
          <div class="font-mono text-sm font-semibold text-accent-dim">STEP 1</div>
          <h3 class="mt-2 text-xl font-semibold">We walk your space.</h3>
          <p class="mt-2 text-[0.98rem] text-muted">
            Ten minutes. We measure, find an outlet, and tell you honestly whether your traffic
            supports a machine.
          </p>
        </div>
        <div class="border-t-[3px] border-ink pt-4">
          <div class="font-mono text-sm font-semibold text-accent-dim">STEP 2</div>
          <h3 class="mt-2 text-xl font-semibold">We install and stock it.</h3>
          <p class="mt-2 text-[0.98rem] text-muted">
            We buy the machine, deliver it, and fill it. You provide a standard outlet and
            nothing else.
          </p>
        </div>
        <div class="border-t-[3px] border-ink pt-4">
          <div class="font-mono text-sm font-semibold text-accent-dim">STEP 3</div>
          <h3 class="mt-2 text-xl font-semibold">We keep it running.</h3>
          <p class="mt-2 text-[0.98rem] text-muted">
            We restock on a set schedule and monitor inventory remotely. Machine problems are
            ours, not yours.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What it costs you -->
  <section class="bg-steel text-paper">
    <div class="mx-auto max-w-[1120px] px-5 py-12 sm:px-8 sm:py-16">
      <div class="grid gap-9 md:grid-cols-[1.1fr_0.9fr] md:items-start">
        <div>
          <h2 class="text-[clamp(2rem,3.6vw,2.75rem)] font-bold text-accent">
            What it costs you
          </h2>
          <p class="mt-5 max-w-[52ch] text-[1.05rem] text-[#D8DCD6]">
            Nothing. We buy the machine and the product, and we make money on what sells. If it
            doesn't sell, that's our problem.
          </p>
          <p class="mt-3.5 max-w-[52ch] text-[1.05rem] text-[#D8DCD6]">
            Depending on your site and volume we'll either pay you a share of sales, a flat
            monthly fee, or place it as a free amenity — we'll tell you which fits your location
            before you sign anything.
          </p>
        </div>
        <div class="border border-steel-2 bg-[#25303880] p-6">
          <ul class="flex flex-col gap-4">
            <li class="flex gap-3.5">
              <strong class="min-w-[7.5ch] flex-none font-mono text-accent">OPTION A</strong>
              <span class="text-[#E7E9E3]">Revenue share — a percentage of what sells</span>
            </li>
            <li class="flex gap-3.5">
              <strong class="min-w-[7.5ch] flex-none font-mono text-accent">OPTION B</strong>
              <span class="text-[#E7E9E3]">Flat monthly fee, regardless of sales</span>
            </li>
            <li class="flex gap-3.5">
              <strong class="min-w-[7.5ch] flex-none font-mono text-accent">OPTION C</strong>
              <span class="text-[#E7E9E3]">Free amenity — no payment either direction</span>
            </li>
          </ul>
          <p class="mt-5 border-t border-steel-2 pt-4 text-sm text-[#AAB3AC]">
            Decided at the walkthrough, based on your site's traffic. Nothing is billed to you in
            any of the three.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Where we place them -->
  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-[1120px] px-5 sm:px-8">
      <div class="mb-9 max-w-[52ch]">
        <h2 class="text-[clamp(1.85rem,3.2vw,2.4rem)] font-semibold">Where we place them</h2>
        <p class="mt-2 text-muted">If your site looks like one of these, a unit likely fits.</p>
      </div>
      <div class="grid grid-cols-2 border border-line bg-white sm:grid-cols-5">
        <div class="flex flex-col items-center gap-2.5 border-r border-b border-line p-6 text-center">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-[26px] w-[26px]" aria-hidden="true"><path d="M4 8h13v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8Z"></path><path d="M17 9h1.5a2.5 2.5 0 0 1 0 5H17"></path><line x1="7" y1="4" x2="7" y2="6"></line><line x1="10.5" y1="3.5" x2="10.5" y2="6"></line></svg>
          <span class="text-sm font-semibold">Break rooms</span>
        </div>
        <div class="flex flex-col items-center gap-2.5 border-r border-b border-line p-6 text-center">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-[26px] w-[26px]" aria-hidden="true"><rect x="2" y="10" width="4" height="4"></rect><rect x="18" y="10" width="4" height="4"></rect><line x1="6" y1="12" x2="18" y2="12"></line></svg>
          <span class="text-sm font-semibold">Gyms</span>
        </div>
        <div class="flex flex-col items-center gap-2.5 border-r border-b border-line p-6 text-center">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-[26px] w-[26px]" aria-hidden="true"><rect x="4" y="3" width="16" height="18"></rect><line x1="8" y1="7" x2="8" y2="9"></line><line x1="12" y1="7" x2="12" y2="9"></line><line x1="16" y1="7" x2="16" y2="9"></line><line x1="8" y1="12" x2="8" y2="14"></line><line x1="12" y1="12" x2="12" y2="14"></line><line x1="16" y1="12" x2="16" y2="14"></line></svg>
          <span class="text-sm font-semibold">Apartment communities</span>
        </div>
        <div class="flex flex-col items-center gap-2.5 border-r border-b border-line p-6 text-center">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-[26px] w-[26px]" aria-hidden="true"><path d="M14 7l3 3-6 6-3.5.5.5-3.5Z"></path><path d="M12 9l3 3"></path><path d="M4 20h6"></path></svg>
          <span class="text-sm font-semibold">Auto shops</span>
        </div>
        <div class="flex flex-col items-center gap-2.5 border-b border-line p-6 text-center sm:border-r-0">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-[26px] w-[26px]" aria-hidden="true"><rect x="4" y="10" width="16" height="9"></rect><path d="M8 10V7l4-2 4 2v3"></path></svg>
          <span class="text-sm font-semibold">Light industrial sites</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Why us -->
  <section class="bg-paper-2 py-12 sm:py-16">
    <div class="mx-auto max-w-[1120px] px-5 sm:px-8">
      <div class="mb-9 max-w-[52ch]">
        <h2 class="text-[clamp(1.85rem,3.2vw,2.4rem)] font-semibold">Why us</h2>
        <p class="mt-2 text-muted">Specifics, not adjectives.</p>
      </div>
      <div class="grid gap-8 lg:grid-cols-[1fr_300px]">
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="relative border border-line bg-white p-6">
            <span class="absolute top-2.5 left-2.5 h-1.5 w-1.5 bg-accent"></span>
            <div class="font-mono text-[clamp(1.4rem,2.4vw,1.85rem)] font-bold">48 HR</div>
            <p class="mt-2 max-w-[38ch] text-[0.96rem] text-muted">
              Response to a reported malfunction.
            </p>
          </div>
          <div class="relative border border-line bg-white p-6">
            <span class="absolute top-2.5 left-2.5 h-1.5 w-1.5 bg-accent"></span>
            <div class="font-mono text-[clamp(1.4rem,2.4vw,1.85rem)] font-bold">WEEKLY</div>
            <p class="mt-2 max-w-[38ch] text-[0.96rem] text-muted">
              Restocked weekly, or sooner when remote monitoring flags a low item.
            </p>
          </div>
          <div class="relative border border-line bg-white p-6">
            <span class="absolute top-2.5 left-2.5 h-1.5 w-1.5 bg-accent"></span>
            <div class="font-mono text-[clamp(1.4rem,2.4vw,1.85rem)] font-bold">$1M / $2M</div>
            <p class="mt-2 max-w-[38ch] text-[0.96rem] text-muted">
              General liability, with your business named as additional insured. Certificate on
              request.
            </p>
          </div>
          <div class="relative border border-line bg-white p-6">
            <span class="absolute top-2.5 left-2.5 h-1.5 w-1.5 bg-accent"></span>
            <div class="font-mono text-[clamp(1.4rem,2.4vw,1.85rem)] font-bold">30 DAYS</div>
            <p class="mt-2 max-w-[38ch] text-[0.96rem] text-muted">
              Written notice ends the agreement, either direction, for any reason.
            </p>
          </div>
          <div class="relative border border-line bg-white p-6 sm:col-span-2">
            <span class="absolute top-2.5 left-2.5 h-1.5 w-1.5 bg-accent"></span>
            <div class="font-mono text-[clamp(1.1rem,1.8vw,1.4rem)] font-bold">CATERED MIX</div>
            <p class="mt-2 max-w-[60ch] text-[0.96rem] text-muted">
              We tune what's stocked to your site — the mix that sells in a gym isn't the mix
              that sells on a shop floor. Snacks, cold drinks, and where it fits, PPE and
              personal-care items.
            </p>
          </div>
        </div>
        <PhotoPlaceholder
          shotId="02"
          aspect="3/4"
          label="Technician restocking a unit, mid-task, landscape or portrait crop to fit this column"
          class="h-full"
        />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-[1120px] px-5 sm:px-8">
      <div class="mb-9 max-w-[52ch]">
        <h2 class="text-[clamp(1.85rem,3.2vw,2.4rem)] font-semibold">Frequently asked</h2>
      </div>
      <div class="max-w-[72ch]">
        <FaqItem question="What does this cost us?" open>
          <p>
            Nothing. We buy the machine and product and make our money on what sells. Depending
            on your site, we'll pay you a share of sales, a flat monthly fee, or place it as a
            free amenity — decided before you sign anything.
          </p>
        </FaqItem>
        <FaqItem question="How much space does it need?">
          <p>
            Roughly 32" wide by 36" deep for the compact unit, plus a standard wall outlet
            nearby.
          </p>
        </FaqItem>
        <FaqItem question="What if it breaks or charges someone wrong?">
          <p>
            It's our problem. Refunds are handled by us, and we respond to a reported
            malfunction within 48 hours.
          </p>
        </FaqItem>
        <FaqItem question="Do we have to sign a long contract?">
          <p>No. Thirty days' written notice ends the agreement, either direction, for any reason.</p>
        </FaqItem>
        <FaqItem question="Are you insured?">
          <p>
            Yes — $1,000,000 / $2,000,000 general liability, with your business named as
            additional insured. Certificate on request.
          </p>
        </FaqItem>
        <FaqItem question="What do you stock?">
          <p>
            Snacks, cold drinks, and where it fits the site, PPE and personal-care items. We tune
            the mix to what actually sells at your location.
          </p>
        </FaqItem>
      </div>
    </div>
  </section>

  <ContactSection />
</Layout>
